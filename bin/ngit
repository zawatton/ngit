#!/bin/sh
# Run ngit (git implemented in NeLisp) with git-style arguments.
here=$(cd "$(dirname "$0")/.." && pwd)
# The NeLisp runtime drops -q, -Q, --batch and --no-init-file even after
# "--", so every argument travels with an "@" prefix behind a "--@" marker.
n=$#
while [ "$n" -gt 0 ]; do a=$1; shift; set -- "$@" "@$a"; n=$((n - 1)); done
exec "${NGIT_NELISP:-nelisp}" --load "$here/lisp/ngit-main.el" -- --@ "$@"
