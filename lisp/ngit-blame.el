;;; ngit-blame.el --- line provenance -*- lexical-binding: t; -*-

;;; Commentary:
;; Pass unchanged lines to parents, following whole-file renames by default.
;; Origins cache trees, blobs and diff records across merge paths.

;;; Code:

(require 'ngit-log)
(require 'ngit-lines)

(defvar ngit-blame--origins nil)
(defvar ngit-blame--blobs nil)
(defvar ngit-blame--ignore-space nil)

(defun ngit-blame--lines (data)
  "Split DATA into records, retaining newlines, with bounded native scans."
  (if (string= data "") []
    (let* ((parts (ngit-lines data)) (out nil))
      (while (cdr parts) (push (concat (pop parts) "\n") out))
      (unless (string= (car parts) "") (push (car parts) out))
      (vconcat (nreverse out)))))

(defun ngit-blame--records (repo bin)
  (or (gethash bin ngit-blame--blobs)
      (let* ((data (cdr (ngit-read-object repo bin)))
             (lines (ngit-blame--lines data))
             (diff-lines (if ngit-blame--ignore-space
                             (ngit-blame--whitespace-records data)
                           lines)))
        (puthash bin (cons lines diff-lines) ngit-blame--blobs))))

(defun ngit-blame--whitespace-records (data)
  "Normalize whitespace while retaining even an unterminated blank record."
  (let ((clean (replace-regexp-in-string "[ \t\r\f\v]+" "" data)))
    (when (and (> (length data) 0) (/= (aref data (1- (length data))) ?\n))
      (setq clean (concat clean "\n")))
    (ngit-blame--lines clean)))

(defun ngit-blame--origin (repo c path &optional bin)
  "An origin is [COMMIT PATH BIN RECORDS PREVIOUS BOUNDARY]."
  (let ((key (concat (ngit--c-hex c) ":" path)))
    (or (gethash key ngit-blame--origins)
        (progn
          (ngit-parse-commit-object repo c)
          (let ((entry (or (and bin (cons #o100644 bin))
                           (ngit--literal-entry repo (ngit--tree-bin c) path))))
            (when (and entry (not (= (car entry) ngit-mode-tree)))
              (puthash key (vector c path (cdr entry) nil nil (null (ngit--c-orig-parents c)))
                       ngit-blame--origins)))))))

(defun ngit-blame--parent (repo origin parent)
  (or (ngit-blame--origin repo parent (aref origin 1))
      (let* ((raw (ngit-diff-trees repo (ngit--tree-bin parent)
                                  (ngit--tree-bin (aref origin 0))))
             ;; blame.c sets single_follow: only this destination participates
             ;; in rename detection, even in a repository-wide import.
             (changes (ngit-diffcore-rename
                       repo (seq-filter (lambda (ch)
                                          (or (= (aref ch 1) ?D)
                                              (and (= (aref ch 1) ?A)
                                                   (string= (aref ch 0) (aref origin 1))))) raw)))
             (found nil))
        (dolist (ch changes)
          (when (and (= (aref ch 1) ?R) (string= (aref ch 0) (aref origin 1)))
            (setq found (ngit-blame--origin repo parent (aref ch 8) (aref ch 3)))))
        found)))

(defun ngit-blame--mapping (repo old new)
  "Map unchanged NEW line indexes to OLD indexes, and changes to -1."
  (let* ((a (cdr (ngit-blame--records repo (aref old 2))))
         (b (cdr (ngit-blame--records repo (aref new 2))))
         (map (make-vector (length b) -1))
         (script (ngit-xdiff--diff-script a b t)) (x 0) (y 0))
    (dolist (edit script)
      (while (< y (aref edit 1))
        (aset map y x) (setq x (1+ x) y (1+ y)))
      (setq x (+ (aref edit 0) (aref edit 2)) y (+ (aref edit 1) (aref edit 3))))
    (while (< y (length b)) (aset map y x) (setq y (1+ y) x (1+ x)))
    map))

(defun ngit-blame--assign (repo start selected owners)
  "Assign SELECTED (FINAL . SOURCE) lines starting at origin START."
  (let ((pending (make-hash-table :test 'equal)) (queue nil))
    (puthash (concat (ngit--c-hex (aref start 0)) ":" (aref start 1)) selected pending)
    (push start queue)
    (while queue
      (let* ((origin (pop queue)) (c (aref origin 0))
             (key (concat (ngit--c-hex c) ":" (aref origin 1)))
             (lines (gethash key pending)) (parents nil) (whole nil))
        (puthash key nil pending)
        ;; Git tests all same-path parents before looking for renames.
        (dolist (p (ngit--c-orig-parents c))
          (let ((po (ngit-blame--origin repo p (aref origin 1))))
            (push (cons p po) parents)))
        (setq parents (nreverse parents))
        (dolist (pair parents)
          (let ((po (cdr pair)))
            (when (and po (equal (aref po 2) (aref origin 2)) (not whole)) (setq whole po))))
        ;; A same-blob parent settles the complete origin without examining
        ;; renames on other merge sides, as pass_blame() does.
        (when whole (setq parents (list (cons (aref whole 0) whole))))
        (dolist (pair parents)
          (unless (cdr pair) (setcdr pair (ngit-blame--parent repo origin (car pair)))))
        (dolist (pair parents)
          (let ((po (cdr pair)))
            (when (and po (not (aref origin 4))) (aset origin 4 po))
            (when (and po (equal (aref po 2) (aref origin 2)) (not whole)) (setq whole po))))
        (when whole (setq parents (list (cons (aref whole 0) whole))))
        (dolist (pair parents)
          (let ((po (cdr pair)))
            (when (and po lines)
              (let ((mapping (unless whole (ngit-blame--mapping repo po origin)))
                    (passed nil) (remain nil))
                (dolist (line lines)
                  (let ((src (if whole (cdr line) (aref mapping (cdr line)))))
                    (if (< src 0) (push line remain) (push (cons (car line) src) passed))))
                (setq lines (nreverse remain))
                (when passed
                  (let* ((pk (concat (ngit--c-hex (aref po 0)) ":" (aref po 1)))
                         (old (gethash pk pending)))
                    (puthash pk (append (nreverse passed) old) pending)
                    (unless old
                      ;; Keep newest suspects first so merge contributions coalesce.
                      (let ((before nil) (tail queue) (date (ngit--c-date (aref po 0))))
                        (while (and tail (>= (ngit--c-date (aref (car tail) 0)) date))
                          (push (pop tail) before))
                        (setq queue (append (nreverse before) (cons po tail)))))))))))
        (dolist (line lines) (aset owners (car line) (cons origin (cdr line))))))))

(defun ngit-blame--ident (ident)
  (let* ((p (ngit--split-ident ident)) (s (car p)) (lt (string-search "<" s)))
    (list (if lt (string-trim-right (substring s 0 lt)) s)
          (if lt (substring s lt) "<>") (nth 1 p) (nth 2 p))))

(defun ngit-blame--porcelain-meta (origin)
  (let* ((c (aref origin 0)) (a (ngit-blame--ident (ngit--c-author c)))
         (co (ngit-blame--ident (ngit--c-committer c))))
    (dolist (pair (list (cons "author" a) (cons "committer" co)))
      (let ((prefix (car pair)) (p (cdr pair)))
        (ngit--emit prefix " " (car p) "\n" prefix "-mail " (nth 1 p) "\n"
                    prefix "-time " (number-to-string (nth 2 p)) "\n"
                    prefix "-tz " (nth 3 p) "\n")))
    (ngit--emit "summary " (ngit--subject (ngit--c-message c)) "\n")
    (when (aref origin 5) (ngit--emit "boundary\n"))))

(defun ngit-blame--range-pos (spec lines start)
  "Resolve a numeric or /regexp/ range endpoint, returning a one-based line."
  (cond ((string= spec "") nil)
        ((string-prefix-p "/" spec)
         (let* ((case-fold-search nil)
                (end (if (string-suffix-p "/" spec) (1- (length spec)) (length spec)))
                (re (ngit--grep-re (substring spec 1 end) 'basic)) (i start) (found nil))
           (while (and (< i (length lines)) (not found))
             (when (string-match-p re (aref lines i)) (setq found (1+ i)))
             (setq i (1+ i)))
           (or found (ngit--die "fatal: No match for %s" spec))))
        (t (string-to-number spec))))

(defun ngit-blame--ranges (specs lines)
  (let ((ranges nil) (anchor 0) (n (length lines)))
    (dolist (spec specs)
      (let* ((comma (if (string-prefix-p "/" spec)
                        (let ((close (string-search "/," spec))) (and close (1+ close)))
                      (string-search "," spec)))
             (left (if comma (substring spec 0 comma) spec))
             (right (and comma (substring spec (1+ comma))))
             (a (or (ngit-blame--range-pos left lines anchor) 1))
             (b (cond ((or (null right) (string= right "")) n)
                      ((string-prefix-p "+" right) (+ a (string-to-number right) -1))
                      ((string-prefix-p "-" right) (prog1 a (setq a (+ a (string-to-number right) 1))))
                      (t (ngit-blame--range-pos right lines (1- a))))))
        (when (> a b) (let ((tmp a)) (setq a b b tmp)))
        (when (or (< a 1) (> a n)) (ngit--die "fatal: file has only %d lines" n))
        (push (cons (1- a) (min n b)) ranges) (setq anchor (min n b))))
    (or ranges (list (cons 0 n)))))

(defun ngit-cmd-blame (repo args)
  (let ((short nil) (email nil) (porcelain nil) (ranges nil) (space nil)
        (abbrev nil) (positional nil) (explicit nil))
    (while args
      (let ((a (pop args)))
        (cond ((string= a "--") (setq positional (append positional args) args nil))
              ((string= a "-s") (setq short t))
              ((string= a "-e") (setq email t))
              ((member a '("--porcelain" "-p")) (setq porcelain t))
              ((string= a "-w") (setq space t))
              ((string= a "-L") (unless args (ngit--die "error: -L requires a value"))
               (push (pop args) ranges))
              ((string-prefix-p "-L" a) (push (substring a 2) ranges))
              ((string-prefix-p "--abbrev=" a) (setq abbrev (string-to-number (substring a 9))))
              ((string-prefix-p "-" a) (ngit--die "unsupported blame option %s" a))
              (t (setq positional (append positional (list a)))))))
    (unless (and positional (<= (length positional) 2)) (ngit--die "usage: git blame [rev] -- file"))
    (let* ((path (car (last positional))) (rev (if (cdr positional) (car positional) "HEAD"))
           (hex (ngit-peel repo (ngit-rev-parse repo rev) 'commit))
           (c (ngit-commit hex))
           (ngit-blame--origins (make-hash-table :test 'equal))
           (ngit-blame--blobs (make-hash-table :test 'equal))
           (ngit-blame--ignore-space space)
           (start (ngit-blame--origin repo c path)))
      (setq explicit (and (cdr positional) t))
      (unless (or start (not explicit)) (ngit--die "fatal: no such path %s in %s" path rev))
      ;; The default final image is the work tree, including uncommitted lines.
      (unless explicit
        (let ((file (expand-file-name path (ngit-repo-toplevel repo))))
          (unless (file-exists-p file) (ngit--die "fatal: Cannot lstat '%s'" path))
          (let* ((data (ngit--read-file file)) (bin (secure-hash 'sha1 data nil nil t)))
            (unless (and start (string= data (cdr (ngit-read-object repo (aref start 2)))))
              (let* ((zero (make-string 40 ?0)) (fake (ngit-commit zero))
                     (now (floor (float-time))) (tz (ngit--tz-string (ngit-local-offset now))))
                (aset fake 2 (list c)) (aset fake 11 (list c)) (aset fake 3 now)
                (aset fake 4 (ngit--c-tree c)) (aset fake 10 t)
                (aset fake 6 (concat "Not Committed Yet <not.committed.yet> " (number-to-string now) " " tz))
                (aset fake 7 (aref fake 6)) (aset fake 8 (concat "Version of " path " from " path "\n"))
                (puthash bin (cons (ngit-blame--lines data)
                                   (if space (ngit-blame--whitespace-records data) (ngit-blame--lines data)))
                         ngit-blame--blobs)
                (setq start (vector fake path bin nil nil nil)))))))
      (unless start (ngit--die "fatal: no such path %s" path))
      (let* ((lines (car (ngit-blame--records repo (aref start 2))))
             (owners (make-vector (length lines) nil)) (selected nil)
             (chosen (make-vector (length lines) nil)) (author-width 0) (file-width 0)
             (line-width 1) (hash-width (if abbrev (if (= abbrev 0) 40 (1+ abbrev)) 8))
             (show-path nil) (seen (make-hash-table :test 'equal)) (metadata (make-hash-table :test 'equal)))
        (dolist (range (ngit-blame--ranges (nreverse ranges) lines))
          (let ((i (car range)))
            (while (< i (cdr range))
              (unless (aref chosen i) (aset chosen i t) (push (cons i i) selected))
              (setq i (1+ i)))))
        (setq selected (sort selected (lambda (a b) (< (car a) (car b)))))
        (ngit-blame--assign repo start selected owners)
        (dolist (line selected)
          (let* ((i (car line)) (origin (car (aref owners i))) (c (aref origin 0))
                 (h (ngit--c-hex c)) (m (gethash h metadata)))
            (unless m
              (let* ((a (ngit-blame--ident (ngit--c-author c)))
                     (name (nth (if email 1 0) a))
                     (date (ngit-show-date (nth 2 a) (nth 3 a) '(iso))))
                (setq m (cons name date)) (puthash h m metadata)
                (unless abbrev (setq hash-width (max hash-width (1+ (length (ngit-abbrev repo h))))))))
            (setq author-width (max author-width (ngit--display-width (car m)))
                  file-width (max file-width (length (aref origin 1)))
                  line-width (max line-width (length (number-to-string (1+ i)))))
            (unless (string= path (aref origin 1)) (setq show-path t))))
        (let ((remaining selected))
          (while remaining
            (let* ((i (caar remaining)) (owner (aref owners i)) (origin (car owner))
                   (c (aref origin 0)) (h (ngit--c-hex c)) (source (cdr owner))
                   (group (list i)) (tail (cdr remaining)) (next (1+ i)) (src (1+ source)))
              (while (and tail (= (caar tail) next)
                          (eq (car (aref owners next)) origin) (= (cdr (aref owners next)) src))
                (push next group) (setq tail (cdr tail) next (1+ next) src (1+ src)))
              (setq group (nreverse group) remaining tail)
              (let ((first t))
                (dolist (ln group)
                  (if porcelain
                      (progn
                        (ngit--emit h " " (number-to-string (1+ (cdr (aref owners ln)))) " "
                                    (number-to-string (1+ ln))
                                    (if first (concat " " (number-to-string (length group))) "") "\n")
                        (when (and first (not (gethash h seen)))
                          (ngit-blame--porcelain-meta origin)
                          (when (aref origin 4)
                            (ngit--emit "previous " (ngit--c-hex (aref (aref origin 4) 0)) " "
                                        (ngit-quote-path (aref (aref origin 4) 1)) "\n"))
                          (ngit--emit "filename " (ngit-quote-path (aref origin 1)) "\n")
                          (puthash h t seen))
                        (ngit--emit "\t"))
                    (ngit--emit (if (aref origin 5)
                                    (concat "^" (substring h 0 (1- hash-width)))
                                  (substring h 0 hash-width)))
                    (when show-path
                      (ngit--emit " " (aref origin 1) (make-string (- file-width (length (aref origin 1))) ?\s)))
                    (unless short
                      (let ((m (gethash h metadata)))
                        (ngit--emit " (" (car m) (make-string (- author-width (ngit--display-width (car m))) ?\s)
                                    " " (cdr m))))
                    (ngit--emit " " (make-string (- line-width (length (number-to-string (1+ ln)))) ?\s)
                                (number-to-string (1+ ln)) ") "))
                  (let ((text (aref lines ln)))
                    (ngit--emit text)
                    (when (or (= (length text) 0) (/= (aref text (1- (length text))) ?\n)) (ngit--emit "\n")))
                  (setq first nil)))))))
      0)))

(provide 'ngit-blame)
;;; ngit-blame.el ends here
