;;; ngit-diff.el --- the diff command -*- lexical-binding: t; -*-

;;; Commentary:

;; `diff' between the index and the work tree, a tree and the index
;; (--cached), a tree and the work tree, or two trees, printed as git's
;; default patch output (diff.c builtin_diff / fill_metainfo) or with
;; --name-only / --name-status.  Hunks come from the xdiff port.  Exact
;; renames are detected; inexact (similarity) renames are not.

;;; Code:

(require 'ngit-status)
(require 'ngit-xdiff)

(defun ngit--diff-blob (repo mode bin)
  "Return the content of side (MODE BIN) as git diffs it."
  (cond ((null bin) "")
        ((= mode ngit-mode-gitlink) (concat "Subproject commit " (ngit-hex bin) "\n"))
        (t (cdr (ngit-read-object repo bin)))))

(defun ngit--binary-p (repo path data)
  (let ((diff (cdr (assoc "diff" (ngit-attrs repo path '("diff"))))))
    (cond ((eq diff 'unset) t)
          ((equal diff "binary") t)
          ((eq diff 'set) nil)
          (t (let ((head (if (> (length data) 8000) (substring data 0 8000) data)))
               (and (string-match-p "\0" head) t))))))

(defun ngit--abbrev-bin (repo bin)
  (if bin (ngit-abbrev repo (ngit-hex bin)) (make-string (ngit-default-abbrev repo) ?0)))

(defun ngit--xdiff-script (old new)
  "Return xdiff's line vectors and edit script for OLD and NEW."
  (let* ((recs1 (ngit-xdiff--split old))
         (recs2 (ngit-xdiff--split new))
         (n1 (length recs1)) (n2 (length recs2))
         (table (make-hash-table :test 'equal :size (+ n1 n2 1)))
         (counts (vector (make-vector (+ n1 n2 1) 0)
                         (make-vector (+ n1 n2 1) 0)))
         ha1 ha2 rchg1 rchg2 dstart dend1 dend2 r1 r2 lim i)
    (puthash :count 0 table)
    (setq ha1 (ngit-xdiff--classify recs1 table counts 0))
    (setq ha2 (ngit-xdiff--classify recs2 table counts 1))
    (setq rchg1 (make-vector (+ n1 2) 0))
    (setq rchg2 (make-vector (+ n2 2) 0))
    (setq i 0 lim (min n1 n2))
    (while (and (< i lim) (eq (aref ha1 i) (aref ha2 i)))
      (setq i (1+ i)))
    (setq dstart i lim (- lim i) i 0)
    (while (and (< i lim)
                (eq (aref ha1 (- n1 1 i)) (aref ha2 (- n2 1 i))))
      (setq i (1+ i)))
    (setq dend1 (- n1 i 1) dend2 (- n2 i 1))
    (setq r1 (ngit-xdiff--cleanup ha1 n1 dstart dend1 (aref counts 1) rchg1))
    (setq r2 (ngit-xdiff--cleanup ha2 n2 dstart dend2 (aref counts 0) rchg2))
    (let* ((nreff1 (length (car r1))) (nreff2 (length (car r2)))
           (ndiags (+ nreff1 nreff2 3)))
      (setq ngit-xdiff--kvdf (make-vector (+ ndiags 1) 0))
      (setq ngit-xdiff--kvdb (make-vector (+ ndiags 1) 0))
      (setq ngit-xdiff--koff (1+ nreff2))
      (setq ngit-xdiff--mxcost (max (ngit-xdiff--bogosqrt ndiags)
                                    ngit-xdiff--max-cost-min))
      (ngit-xdiff--recs-cmp (cdr r1) (car r1) rchg1 0 nreff1
                            (cdr r2) (car r2) rchg2 0 nreff2 nil))
    (setq ngit-xdiff--kvdf nil ngit-xdiff--kvdb nil)
    (let ((xdf1 (vector n1 ha1 rchg1 recs1 (make-vector (max n1 1) -2)))
          (xdf2 (vector n2 ha2 rchg2 recs2 (make-vector (max n2 1) -2))))
      (ngit-xdiff--change-compact xdf1 xdf2)
      (ngit-xdiff--change-compact xdf2 xdf1))
    (vector recs1 recs2 (ngit-xdiff--build-script rchg1 n1 rchg2 n2))))

(defun ngit--combined-line (rec)
  "Return REC without its line feed, as combine-diff stores it."
  (if (and (> (length rec) 0) (= (aref rec (1- (length rec))) 10))
      (substring rec 0 (1- (length rec)))
    rec))

(defun ngit--combined-coalesce (base new parent)
  "Coalesce lost lines NEW into BASE for PARENT using git's LCS ties."
  (cond
   ((null new) base)
   ((null base) new)
   (t
    (let* ((a (vconcat base)) (b (vconcat new))
           (na (length a)) (nb (length b))
           (lcs (make-vector (1+ na) nil))
           (dir (make-vector (1+ na) nil))
           (i 0) j)
      (while (<= i na)
        (aset lcs i (make-vector (1+ nb) 0))
        (aset dir i (make-vector (1+ nb) 'base))
        (setq i (1+ i)))
      (setq j 1)
      (while (<= j nb)
        (aset (aref dir 0) j 'new)
        (setq j (1+ j)))
      (setq i 1)
      (while (<= i na)
        (setq j 1)
        (while (<= j nb)
          (cond
           ((string= (aref (aref a (1- i)) 0) (aref (aref b (1- j)) 0))
            (aset (aref lcs i) j (1+ (aref (aref lcs (1- i)) (1- j))))
            (aset (aref dir i) j 'match))
           ((>= (aref (aref lcs i) (1- j))
                (aref (aref lcs (1- i)) j))
            (aset (aref lcs i) j (aref (aref lcs i) (1- j)))
            (aset (aref dir i) j 'new))
           (t
            (aset (aref lcs i) j (aref (aref lcs (1- i)) j))
            (aset (aref dir i) j 'base)))
          (setq j (1+ j)))
        (setq i (1+ i)))
      (setq i na j nb)
      (let (actions out)
        (while (or (> i 0) (> j 0))
          (let ((d (aref (aref dir i) j)))
            (push d actions)
            (cond ((eq d 'match) (setq i (1- i) j (1- j)))
                  ((eq d 'new) (setq j (1- j)))
                  (t (setq i (1- i))))))
        (setq i 0 j 0)
        (dolist (d actions)
          (cond
           ((eq d 'match)
            (let ((line (copy-sequence (aref a i))))
              (aset line 1 (logior (aref line 1) (ash 1 parent)))
              (push line out))
            (setq i (1+ i) j (1+ j)))
           ((eq d 'new)
            (push (aref b j) out)
            (setq j (1+ j)))
           (t
            (push (aref a i) out)
            (setq i (1+ i)))))
        (nreverse out))))))

(defun ngit--combined-find (lines mark i cnt want-clear)
  (while (and (<= i cnt)
              (if want-clear
                  (/= 0 (logand (aref (aref lines i) 1) mark))
                (= 0 (logand (aref (aref lines i) 1) mark))))
    (setq i (1+ i)))
  i)

(defun ngit--combined-adjust-tail (lines all begin i)
  (if (and (<= (1+ begin) i)
           (= 0 (logand (aref (aref lines (1- i)) 1) all)))
      (1- i)
    i))

(defun ngit--combined-give-context (lines cnt ctx)
  (let* ((mark 4) (no-pre 8)
         (i (ngit--combined-find lines mark 0 cnt nil)))
    (if (> i cnt)
        nil
      (while (<= i cnt)
        (let ((j (max 0 (- i ctx))) k)
          (while (< j i)
            (when (= 0 (logand (aref (aref lines j) 1) mark))
              (aset (aref lines j) 1
                    (logior (aref (aref lines j) 1) no-pre)))
            (aset (aref lines j) 1 (logior (aref (aref lines j) 1) mark))
            (setq j (1+ j)))
          (let ((again t))
            (while again
              (setq again nil)
              (setq j (ngit--combined-find lines mark i cnt t))
              (if (> j cnt)
                  (setq i (1+ cnt))
                (setq k (ngit--combined-find lines mark j cnt nil))
                (setq j (ngit--combined-adjust-tail lines 3 i j))
                (if (< k (+ j ctx))
                    (progn
                      (while (< j k)
                        (aset (aref lines j) 1
                              (logior (aref (aref lines j) 1) mark))
                        (setq j (1+ j)))
                      (setq i k again t))
                  (setq i k k (min (1+ cnt) (+ j ctx)))
                  (while (< j k)
                    (aset (aref lines j) 1
                          (logior (aref (aref lines j) 1) mark))
                    (setq j (1+ j)))))))))
      t)))

(defun ngit--combined-make-hunks (lines cnt ctx)
  "Mark dense combined hunks in LINES and add CTX context."
  (let ((i 0) (mark 4) (all 3))
    (while (<= i cnt)
      (if (or (/= 0 (logand (aref (aref lines i) 1) all))
              (aref (aref lines i) 2))
          (aset (aref lines i) 1 (logior (aref (aref lines i) 1) mark))
        (aset (aref lines i) 1 (logand (aref (aref lines i) 1) (lognot mark))))
      (setq i (1+ i)))
    (setq i 0)
    (while (<= i cnt)
      (while (and (<= i cnt) (= 0 (logand (aref (aref lines i) 1) mark)))
        (setq i (1+ i)))
      (when (<= i cnt)
        (let ((begin i) (j (1+ i)) end (same 0) interesting)
          (catch 'end
            (while (<= j cnt)
              (when (= 0 (logand (aref (aref lines j) 1) mark))
                (let* ((la (ngit--combined-adjust-tail lines all begin j))
                       (limit (min (1+ cnt) (+ la ctx))) (found nil))
                  (setq la limit)
                  (while (and (> la 0) (<= j (1- la)) (not found))
                    (setq la (1- la))
                    (when (/= 0 (logand (aref (aref lines la) 1) mark))
                      (setq found t)))
                  (unless found (throw 'end nil))
                  (setq j la)))
              (setq j (1+ j))))
          (setq end j j begin)
          (while (and (< j end) (not interesting))
            (let ((d (logand (aref (aref lines j) 1) all)))
              (when (/= d 0)
                (if (= same 0) (setq same d)
                  (unless (= same d) (setq interesting t)))))
            (dolist (lost (aref (aref lines j) 2))
              (let ((d (aref lost 1)))
                (if (= same 0) (setq same d)
                  (unless (= same d) (setq interesting t)))))
            (setq j (1+ j)))
          (when (and (not interesting) (/= same all))
            (setq j begin)
            (while (< j end)
              (aset (aref lines j) 1
                    (logand (aref (aref lines j) 1) (lognot mark)))
              (setq j (1+ j))))
          (setq i end))))
    (ngit--combined-give-context lines cnt ctx)))

(defun ngit--combined-output-line (line)
  (if (and (> (length line) 0) (= (aref line (1- (length line))) 13))
      (concat (substring line 0 (1- (length line))) "\r\n")
    (concat line "\n")))

(defun ngit--combined-u64 (n)
  "Return N interpreted as an unsigned 64-bit counter."
  (if (< n 0) (+ n 18446744073709551616) n))

(defun ngit--combined-dump (lines cnt ctx)
  (let ((lno 0) (mark 4) (no-pre 8) (all 3) out comment)
    (while (<= lno cnt)
      (while (and (<= lno cnt) (= 0 (logand (aref (aref lines lno) 1) mark)))
        (let ((line (aref (aref lines lno) 0)))
          (when (and line (> (length line) 0)
                     (let ((c (aref line 0)))
                       (or (and (>= c ?a) (<= c ?z))
                           (and (>= c ?A) (<= c ?Z)) (memq c '(?_ ?$)))))
            (setq comment line)))
        (setq lno (1+ lno)))
      (when (<= lno cnt)
        (let ((end (1+ lno)) (null-context 0) rlines i)
          (while (and (<= end cnt)
                      (/= 0 (logand (aref (aref lines end) 1) mark)))
            (setq end (1+ end)))
          (setq rlines (- end lno))
          (when (< cnt end) (setq rlines (1- rlines)))
          (when (= ctx 0)
            (setq i lno)
            (while (< i end)
              (when (= 0 (logand (aref (aref lines i) 1) all))
                (setq null-context (1+ null-context)))
              (setq i (1+ i)))
            (setq rlines (- rlines null-context)))
          (let ((p0 (aref (aref (aref lines lno) 3) 0))
                (p1 (aref (aref (aref lines lno) 3) 1))
                (e0 (aref (aref (aref lines end) 3) 0))
                (e1 (aref (aref (aref lines end) 3) 1))
                (comment-limit (and comment (min 40 (length comment))))
                (comment-pos 0) (comment-end 0))
            (while (and comment-limit (< comment-pos comment-limit))
              (unless (memq (aref comment comment-pos) '(9 10 11 12 13 32))
                (setq comment-end comment-pos))
              (setq comment-pos (1+ comment-pos)))
            (push (concat "@@@ -" (number-to-string p0) ","
                          (number-to-string (ngit--combined-u64 (- e0 p0 null-context)))
                          " -" (number-to-string p1) ","
                          (number-to-string (ngit--combined-u64 (- e1 p1 null-context)))
                          " +" (number-to-string (1+ lno)) ","
                          (number-to-string (ngit--combined-u64 rlines)) " @@@"
                          (if (> comment-end 0)
                              (concat " " (substring comment 0 comment-end))
                            "")
                          "\n") out))
          (while (< lno end)
            (let* ((sl (aref lines lno))
                   (lost (if (/= 0 (logand (aref sl 1) no-pre)) nil (aref sl 2))))
              (dolist (ll lost)
                (push (concat (if (/= 0 (logand (aref ll 1) 1)) "-" " ")
                              (if (/= 0 (logand (aref ll 1) 2)) "-" " ")
                              (ngit--combined-output-line (aref ll 0))) out))
              (setq lno (1+ lno))
              (when (<= lno cnt)
                (unless (and (= ctx 0) (= 0 (logand (aref sl 1) all)))
                  (push (concat (if (/= 0 (logand (aref sl 1) 1)) "+" " ")
                                (if (/= 0 (logand (aref sl 1) 2)) "+" " ")
                                (ngit--combined-output-line (aref sl 0))) out)))))
          (setq comment nil))))
    (apply #'concat (nreverse out))))

(defun ngit--combined-hunks (parent0 parent1 result ctx)
  "Return dense combined hunks for two PARENT strings and RESULT."
  (let* ((d0 (ngit--xdiff-script parent0 result))
         (d1 (ngit--xdiff-script parent1 result))
         (result-lines (aref d0 1)) (cnt (length result-lines))
         (lines (make-vector (+ cnt 2) nil)) (i 0))
    (while (<= i (1+ cnt))
      (aset lines i (vector (and (< i cnt) (ngit--combined-line (aref result-lines i)))
                            0 nil (vector 0 0)))
      (setq i (1+ i)))
    (let ((parent 0))
      (dolist (d (list d0 d1))
        (let (per-bucket)
          (dolist (h (aref d 2))
            (let ((pi (aref h 0)) (ri (aref h 1))
                  (pn (aref h 2)) (rn (aref h 3)) lost)
              (while (< pi (+ (aref h 0) pn))
                (push (vector (ngit--combined-line (aref (aref d 0) pi))
                              (ash 1 parent)) lost)
                (setq pi (1+ pi)))
              (when lost
                (let ((cell (assoc ri per-bucket)))
                  (if cell (setcdr cell (append (cdr cell) (nreverse lost)))
                    (push (cons ri (nreverse lost)) per-bucket))))
              (while (< ri (+ (aref h 1) rn))
                (aset (aref lines ri) 1
                      (logior (aref (aref lines ri) 1) (ash 1 parent)))
                (setq ri (1+ ri)))))
          (dolist (bucket per-bucket)
            (let ((sl (aref lines (car bucket))))
              (aset sl 2 (ngit--combined-coalesce (aref sl 2) (cdr bucket) parent)))))
        (let ((p-line 1) (mask (ash 1 parent)))
          (setq i 0)
          (while (<= i cnt)
            (aset (aref (aref lines i) 3) parent p-line)
            (dolist (ll (aref (aref lines i) 2))
              (when (/= 0 (logand (aref ll 1) mask))
                (setq p-line (1+ p-line))))
            (when (and (< i cnt) (= 0 (logand (aref (aref lines i) 1) mask)))
              (setq p-line (1+ p-line)))
            (setq i (1+ i)))
          (aset (aref (aref lines (1+ cnt)) 3) parent p-line))
        (setq parent (1+ parent))))
    (ngit--combined-make-hunks lines cnt ctx)
    (ngit--combined-dump lines cnt ctx)))

(defun ngit--unmerged-raw-mode (repo path)
  "Return PATH's raw work-tree mode, or zero when it is absent."
  (ngit-wt-setup (ngit-repo-toplevel repo))
  (let ((st (ngit-wt-lstat path)))
    (if st (ngit-wt-mode st) 0)))

(defun ngit--unmerged-gitlink-result (repo path)
  "Return combined-diff text for a gitlink work-tree PATH."
  (let* ((top (ngit-repo-toplevel repo))
         (dir (expand-file-name (decode-coding-string path 'utf-8) top))
         (populated (file-exists-p (expand-file-name ".git" dir)))
         (sub (and populated (ngit-discover dir)))
         (head (and sub (ngit-resolve-ref sub "HEAD")))
         (bin (and head (ngit-unhex head))))
    (concat "Subproject commit "
            (if bin (ngit-hex bin) (make-string 40 ?0)) "\n")))

(defun ngit--emit-combined (repo c stage2 stage3 ctx)
  "Emit a two-parent combined work-tree diff for unmerged change C."
  (ngit-wt-setup (ngit-repo-toplevel repo))
  (let* ((path (aref c 0)) (st (ngit-wt-lstat path))
         (mode2 (aref stage2 2)) (mode3 (aref stage3 2))
         (bin2 (aref stage2 1)) (bin3 (aref stage3 1))
         (raw-mode (and st (ngit-wt-mode st)))
         (wt-mode (if (and raw-mode (/= raw-mode ngit-mode-tree)) raw-mode (aref c 4)))
         (result (if (= wt-mode ngit-mode-gitlink)
                     (ngit--unmerged-gitlink-result repo path)
                   (or (aref c 7) "")))
         (old2 (ngit--diff-blob repo mode2 bin2))
         (old3 (ngit--diff-blob repo mode3 bin3))
         (quoted (ngit-quote-path path))
         (a-name (ngit-quote-path (concat "a/" path)))
         (b-name (ngit-quote-path (concat "b/" path)))
         (mode-diff (or (/= mode2 wt-mode) (/= mode3 wt-mode))))
    (ngit--emit "diff --cc " quoted "\nindex "
                (ngit--abbrev-bin repo bin2) "," (ngit--abbrev-bin repo bin3)
                ".." (make-string (ngit-default-abbrev repo) ?0) "\n")
    (when mode-diff
      (if (= wt-mode 0)
          (ngit--emit "deleted file mode " (ngit--octal6 mode2) ","
                      (ngit--octal6 mode3) "\n")
        (ngit--emit "mode " (ngit--octal6 mode2) "," (ngit--octal6 mode3)
                    ".." (ngit--octal6 wt-mode) "\n")))
    (if (or (ngit--binary-p repo path old2) (ngit--binary-p repo path old3)
            (ngit--binary-p repo path result))
        (ngit--emit "Binary files differ\n")
      (ngit--emit "--- " a-name "\n+++ "
                  (if (= wt-mode 0) "/dev/null" b-name) "\n")
      (when st
        (ngit--emit (ngit--combined-hunks old2 old3 result ctx))))))

(defun ngit--emit-patch-part (repo path-a path-b old-mode old-bin new-mode new-bin
                                  new-data dirty rename ctx)
  "Emit one file pair; a nil BIN means that side is absent."
  (let* ((a-name (ngit-quote-path (concat "a/" path-a)))
         (b-name (ngit-quote-path (concat "b/" path-b)))
         (lbl-a (if old-bin a-name "/dev/null"))
         (lbl-b (if (or new-bin new-data) b-name "/dev/null"))
         (header (list (concat "diff --git " a-name " " b-name "\n"))))
    (cond ((null old-bin)
           (push (concat "new file mode " (ngit--octal6 new-mode) "\n") header))
          ((not (or new-bin new-data))
           (push (concat "deleted file mode " (ngit--octal6 old-mode) "\n") header))
          ((/= old-mode new-mode)
           (push (concat "old mode " (ngit--octal6 old-mode) "\nnew mode "
                         (ngit--octal6 new-mode) "\n")
                 header)))
    (when rename
      (push (concat "similarity index " (number-to-string (if (numberp rename) rename 100))
                    "%\nrename from " (ngit-quote-path path-a)
                    "\nrename to " (ngit-quote-path path-b) "\n")
            header))
    (unless (equal old-bin new-bin)
      (push (concat "index " (ngit--abbrev-bin repo old-bin) ".."
                    (ngit--abbrev-bin repo new-bin)
                    (if (= old-mode new-mode) (concat " " (ngit--octal6 old-mode)) "")
                    "\n")
            header))
    (let* ((old (ngit--diff-blob repo old-mode old-bin))
           (new (cond ((and new-bin (= new-mode ngit-mode-gitlink))
                       (concat "Subproject commit " (ngit-hex new-bin) (if dirty "-dirty" "") "\n"))
                      (new-data new-data)
                      (t (ngit--diff-blob repo new-mode new-bin)))))
      (apply #'ngit--emit (nreverse header))
      (cond
       ((and (or (and old-bin (/= old-mode ngit-mode-gitlink))
                 (and new-bin (/= new-mode ngit-mode-gitlink)))
             (or (ngit--binary-p repo path-a old) (ngit--binary-p repo path-b new)))
        (unless (and (equal old-bin new-bin) (not dirty))
          (ngit--emit "Binary files " lbl-a " and " lbl-b " differ\n")))
       (t
        (let ((hunks (ngit-xdiff-unified old new ctx)))
          (unless (string= hunks "")
            ;; diff.c appends a tab to a name containing a space.
            (ngit--emit "--- " lbl-a (if (and old-bin (string-search " " path-a)) "\t" "")
                        "\n+++ " lbl-b
                        (if (and (or new-bin new-data) (string-search " " path-b)) "\t" "")
                        "\n" hunks))))))))

(defun ngit--emit-patch (repo c ctx)
  (let* ((path (aref c 0))
         (old-path (or (aref c 8) path))
         (old-mode (aref c 2)) (new-mode (aref c 4))
         (flags (aref c 6))
         (dirty (and (listp flags) (or (memq 'modified flags) (memq 'untracked flags))))
         (new-bin (aref c 5)))
    (if (and (aref c 3) (or new-bin (aref c 7))
             (/= (logand old-mode #o170000) (logand new-mode #o170000)))
        (progn
          (ngit--emit-patch-part repo old-path path old-mode (aref c 3) 0 nil nil nil nil ctx)
          (ngit--emit-patch-part repo old-path path 0 nil new-mode new-bin (aref c 7) nil nil ctx))
      (ngit--emit-patch-part repo old-path path old-mode (aref c 3) new-mode new-bin
                             (aref c 7) dirty
                             (and (= (aref c 1) ?R)
                                  (if (> (length c) 9) (/ (* (aref c 9) 100) 60000) 100))
                             ctx))))

(defun ngit--unmerged-stages (c)
  (let ((extra (aref c 6)))
    (and (vectorp extra) (= (length extra) 4) extra)))

(defun ngit--combined-change-p (c)
  (let ((stages (and (= (aref c 1) ?U) (ngit--unmerged-stages c))))
    (and stages (aref stages 2) (aref stages 3))))

(defun ngit--unmerged-wt-bin (repo c old-bin)
  (cond ((= (aref c 4) ngit-mode-gitlink)
         (car (ngit-submodule-state repo (aref c 0) old-bin)))
        ((and (/= (aref c 4) 0) (aref c 7)) (ngit-hash-blob (aref c 7)))))

(defun ngit--unmerged-normalized-mode (repo path old-mode fallback-mode)
  "Return PATH's work-tree mode normalized against OLD-MODE."
  (let ((mode (ngit--unmerged-raw-mode repo path)))
    (cond ((= mode ngit-mode-tree) fallback-mode)
          ((and (/= mode 0) (not (ngit-config-bool repo "core.filemode" t))
                (eq (ngit--type-class mode) 'file)
                (eq (ngit--type-class old-mode) 'file))
           old-mode)
          (t mode))))

(defun ngit--unmerged-stage2-change (repo c)
  "Return the ordinary stage-2 to work-tree change for C, or nil."
  (let* ((stages (ngit--unmerged-stages c))
         (stage2 (and stages (aref stages 2))))
    (when stage2
      (let* ((path (aref c 0)) (old-mode (aref stage2 2)) (old-bin (aref stage2 1))
             (new-mode (ngit--unmerged-normalized-mode repo path old-mode (aref c 4)))
             (state (and (= new-mode ngit-mode-gitlink)
                         (ngit-submodule-state repo path old-bin)))
             (new-bin (if state (car state) (ngit--unmerged-wt-bin repo c old-bin)))
             (flags (and state (delq 'untracked (copy-sequence (cdr state)))))
             (data (aref c 7)))
        (unless (and (= old-mode new-mode) (equal old-bin new-bin) (null flags))
          (ngit-change path
                       (cond ((= new-mode 0) ?D)
                             ((not (eq (ngit--type-class old-mode)
                                       (ngit--type-class new-mode))) ?T)
                             (t ?M))
                       old-mode old-bin new-mode new-bin flags data))))))

(defun ngit--tree-unmerged-wt (repo tree-change wt-change)
  "Compose TREE-CHANGE and unmerged WT-CHANGE directly tree to work tree."
  (let* ((path (aref tree-change 0))
         (old-mode (aref tree-change 2)) (old-bin (aref tree-change 3))
         (new-mode (ngit--unmerged-normalized-mode repo path old-mode (aref wt-change 4)))
         (data (aref wt-change 7))
         (state (and (= new-mode ngit-mode-gitlink)
                     (ngit-submodule-state repo path old-bin)))
         (new-bin (if state (car state)
                    (and (/= new-mode 0) data (ngit-hash-blob data))))
         (flags (and state (delq 'untracked (copy-sequence (cdr state))))))
    (unless (and (= old-mode new-mode) (equal old-bin new-bin) (null flags))
      (ngit-change path
                   (cond ((= old-mode 0) ?A)
                         ((= new-mode 0) ?D)
                         ((not (eq (ngit--type-class old-mode)
                                   (ngit--type-class new-mode))) ?T)
                         (t ?M))
                   old-mode old-bin new-mode new-bin flags data))))

(defun ngit--unmerged-name-queue (repo changes cached renames)
  "Expand unmerged CHANGES as Git's non-combined name queue."
  (let (queue)
    (dolist (c changes)
      (let ((stages (and (= (aref c 1) ?U) (ngit--unmerged-stages c))))
        (if (null stages)
            (push c queue)
          (let ((placeholder (copy-sequence c)))
            ;; diff_unmerge has an invalid old side and a work-tree new side.
            ;; Present work-tree paths therefore participate as rename targets.
            (when (/= (aref c 4) 0)
              (aset placeholder 1 ?A)
              (aset placeholder 5
                    (ngit--unmerged-wt-bin repo c
                                           (and (aref stages 2) (aref (aref stages 2) 1)))))
            (push placeholder queue))
          (unless cached
            (let ((ordinary (ngit--unmerged-stage2-change repo c)))
              (when ordinary (push ordinary queue)))))))
    (setq queue (nreverse queue))
    (when renames (setq queue (ngit-detect-renames queue)))
    (dolist (c queue)
      (when (ngit--unmerged-stages c) (aset c 1 ?U)))
    queue))

(defun ngit--compose-tree-wt (repo tree-changes wt-changes)
  "Combine tree->index and index->work tree changes into tree->work tree."
  (let ((wt (make-hash-table :test 'equal)) (out nil) (seen (make-hash-table :test 'equal)))
    (dolist (w wt-changes) (puthash (aref w 0) w wt))
    (dolist (c tree-changes)
      (let ((w (gethash (aref c 0) wt)))
        (puthash (aref c 0) t seen)
        (cond
         ((= (aref c 1) ?U)
          (when w
            (let ((n (ngit--tree-unmerged-wt repo c w)))
              (when n (push n out)))))
         ((null w) (push c out))
         ((= (aref w 1) ?D)
          (when (aref c 3)
            (push (ngit-change (aref c 0) ?D (aref c 2) (aref c 3) 0 nil) out)))
         ((null (aref c 3))
          (let ((n (copy-sequence w))) (aset n 1 ?A) (aset n 2 0) (aset n 3 nil) (push n out)))
         (t
          (unless (and (equal (aref c 3) (aref w 5)) (= (aref c 2) (aref w 4)) (null (aref w 6)))
            (let ((n (copy-sequence w)))
              (aset n 2 (aref c 2)) (aset n 3 (aref c 3))
              (aset n 1 (if (= (logand (aref c 2) #o170000) (logand (aref w 4) #o170000)) ?M ?T))
              (push n out)))))))
    (dolist (w wt-changes)
      (unless (gethash (aref w 0) seen) (push w out)))
    (sort out (lambda (x y) (string< (aref x 0) (aref y 0))))))

(defun ngit--tree-of (repo rev)
  (ngit-unhex (ngit-peel repo (ngit-rev-parse repo rev) 'tree)))

(defun ngit-cmd-diff (repo args)
  (let ((cached nil) (ctx 3) (out 'patch) (renames (ngit-config-get repo "diff.renames"))
        (revs nil) (paths nil) (expanded-unmerged nil))
    (setq renames (if (null renames) t
                    (or (equal renames "copies") (equal renames "copy")
                        (ngit-config-bool repo "diff.renames" t))))
    (while args
      (let ((a (pop args)))
        (cond ((member a '("--cached" "--staged")) (setq cached t))
              ((string-match "\\`\\(?:-U\\|--unified=\\)\\([0-9]+\\)\\'" a)
               (setq ctx (string-to-number (match-string 1 a))))
              ((string= a "--name-only") (setq out 'name-only))
              ((string= a "--name-status") (setq out 'name-status))
              ((string= a "--no-renames") (setq renames nil))
              ((member a '("-M" "--find-renames")) (setq renames t))
              ((string= a "--") (setq paths args args nil))
              ((string-prefix-p "-" a) (ngit--die "unsupported diff option %s" a))
              ((string-match "\\`\\(.*\\)\\.\\.\\(.*\\)\\'" a)
               (push (if (string= (match-string 1 a) "") "HEAD" (match-string 1 a)) revs)
               (push (if (string= (match-string 2 a) "") "HEAD" (match-string 2 a)) revs))
              (t (push a revs)))))
    (setq revs (nreverse revs))
    (let* ((items (ngit-paths-items repo paths))
           (changes
            (ngit-paths-filter-changes
             items
             (cond
            ((= (length revs) 2)
             (ngit-diff-trees repo (ngit--tree-of repo (car revs)) (ngit--tree-of repo (cadr revs))))
            (cached
             (let ((head (ngit-resolve-ref repo "HEAD")))
               (ngit-diff-tree-index repo (cond (revs (ngit--tree-of repo (car revs)))
                                                (head (ngit--tree-of repo "HEAD"))))))
            (revs
             (ngit--compose-tree-wt repo (ngit-diff-tree-index repo (ngit--tree-of repo (car revs)))
                                    (ngit-wt-changes repo t)))
              (t (ngit-wt-changes repo t))))))
      (cond
       ((memq out '(name-only name-status))
        (setq changes (ngit--unmerged-name-queue repo changes cached renames)
              expanded-unmerged t))
       ((and (eq out 'patch) (not cached) (null revs))
        (let (combined queued)
          (dolist (c changes)
            (if (ngit--combined-change-p c) (push c combined) (push c queued)))
          (setq changes
                (append (nreverse combined)
                        (ngit--unmerged-name-queue repo (nreverse queued) nil renames))
                expanded-unmerged t)))
       (renames (setq changes (ngit-detect-renames changes))))
      (dolist (c changes)
        (if (null (ngit--unmerged-stages c))
            (pcase out
              ('name-only (ngit--emit (ngit-quote-path (aref c 0)) "\n"))
              ('name-status
               (ngit--emit (if (= (aref c 1) ?R) "R100" (string (if (eq (aref c 6) 'ita) ?A (aref c 1))))
                           "\t"
                           (if (aref c 8) (concat (ngit-quote-path (aref c 8)) "\t") "")
                           (ngit-quote-path (aref c 0)) "\n"))
              (_ (ngit--emit-patch repo c ctx)))
          (let* ((stages (ngit--unmerged-stages c))
                 (stage2 (and stages (aref stages 2)))
                 (stage3 (and stages (aref stages 3)))
                 (ordinary (and (not expanded-unmerged) (eq out 'patch) (not cached)
                                (ngit--unmerged-stage2-change repo c))))
            (pcase out
              ('name-only
               (ngit--emit (ngit-quote-path (aref c 0)) "\n"))
              ('name-status
               (ngit--emit (if (aref c 8) "U100" "U") "\t"
                           (ngit-quote-path (or (aref c 8) (aref c 0))) "\n"))
              (_
               (cond
                (cached
                 (ngit--emit "* Unmerged path " (or (aref c 8) (aref c 0)) "\n"))
                ((and stage2 stage3) (ngit--emit-combined repo c stage2 stage3 ctx))
                (t
                 (ngit--emit "* Unmerged path " (or (aref c 8) (aref c 0)) "\n")
                 (when ordinary (ngit--emit-patch repo ordinary ctx)))))))))
    0)))

(provide 'ngit-diff)

