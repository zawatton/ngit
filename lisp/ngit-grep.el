;;; ngit-grep.el --- tracked file search -*- lexical-binding: t; -*-

;;; Commentary:
;; Compile patterns once and search complete buffers.  Per-line masks combine
;; grep expressions without running a regexp for every line of every file.

;;; Code:

(require 'ngit-log)
(require 'ngit-lines)

(defvar ngit-grep--tokens nil)

(defun ngit-grep--plain-p (pat)
  (let ((i 0) (plain t))
    (while (and plain (< i (length pat)))
      (when (memq (aref pat i) '(?. ?* ?^ ?$ ?\[ ?\\ ?+ ?? ?\( ?\) ?\{ ?\} ?|)) (setq plain nil))
      (setq i (1+ i)))
    plain))

(defun ngit-grep--regexp (pat mode)
  "Translate POSIX basic/extended PAT to an Emacs regexp."
  (if (eq mode 'fixed) (regexp-quote (decode-coding-string pat 'utf-8))
    (let ((i 0) (parts nil) (class nil) (first nil) (n (length pat))
          (ere (eq mode 'extended)))
      (while (< i n)
        (let ((ch (aref pat i)))
          (cond
           (class
            (push (string ch) parts)
            (when (and (= ch ?\]) (not first)) (setq class nil))
            (unless (and first (= ch ?^)) (setq first nil))
            (setq i (1+ i)))
           ((= ch ?\[) (push "[" parts) (setq class t first t i (1+ i)))
           ((and (= ch ?\\) (< (1+ i) n))
            (let ((nx (aref pat (1+ i))))
              (push (cond ((memq nx '(?\( ?\) ?\{ ?\} ?|))
                           (if ere (string nx) (string ?\\ nx)))
                          ((memq nx '(?+ ??)) (if ere (concat "[" (string nx) "]") (string nx)))
                          (t (string ?\\ nx))) parts)
              (setq i (+ i 2))))
           ((memq ch '(?\( ?\) ?\{ ?\} ?|))
            (push (if ere (string ?\\ ch) (string ch)) parts) (setq i (1+ i)))
           ((and (not ere) (memq ch '(?+ ??)))
            (push (concat "[" (string ch) "]") parts) (setq i (1+ i)))
           (t (push (unibyte-string ch) parts) (setq i (1+ i))))))
      (decode-coding-string (string-as-unibyte (apply #'concat (nreverse parts))) 'utf-8))))

(defun ngit-grep--term ()
  (let ((a (pop ngit-grep--tokens)))
    (cond ((integerp a) a)
          ((eq a 'not) (list 'not (ngit-grep--term)))
          ((eq a 'open)
           (let ((expr (ngit-grep--or)))
             (unless (eq (pop ngit-grep--tokens) 'close) (ngit--die "fatal: unmatched parenthesis"))
             expr))
          (t (ngit--die "fatal: invalid grep expression")))))

(defun ngit-grep--and ()
  (let ((a (ngit-grep--term)))
    (while (eq (car ngit-grep--tokens) 'and)
      (pop ngit-grep--tokens) (setq a (list 'and a (ngit-grep--term))))
    a))

(defun ngit-grep--or ()
  (let ((a (ngit-grep--and)))
    (while (and ngit-grep--tokens (not (eq (car ngit-grep--tokens) 'close)))
      (when (eq (car ngit-grep--tokens) 'or) (pop ngit-grep--tokens))
      (setq a (list 'or a (ngit-grep--and))))
    a))

(defun ngit-grep--eval (expr mask)
  (cond ((integerp expr) (/= 0 (logand mask (ash 1 expr))))
        ((eq (car expr) 'not) (not (ngit-grep--eval (cadr expr) mask)))
        ((eq (car expr) 'and) (and (ngit-grep--eval (cadr expr) mask) (ngit-grep--eval (nth 2 expr) mask)))
        (t (or (ngit-grep--eval (cadr expr) mask) (ngit-grep--eval (nth 2 expr) mask)))))

(defun ngit-grep--negative-p (expr)
  (and (consp expr) (or (eq (car expr) 'not)
                        (ngit-grep--negative-p (cadr expr))
                        (ngit-grep--negative-p (nth 2 expr)))))

(defun ngit-grep--lookahead-p (expr)
  (or (integerp expr)
      (and (eq (car expr) 'or) (ngit-grep--lookahead-p (cadr expr))
           (ngit-grep--lookahead-p (nth 2 expr)))))

(defun ngit-grep--line-start (data pos)
  "Find the start of POS's line with bounded native searches."
  (let ((end pos) (found nil))
    (while (and (> end 0) (not found))
      (let* ((start (max 0 (- end 1024))) (chunk (substring data start end))
             (from 0) (nl nil) (last nil))
        (while (setq nl (string-search "\n" chunk from)) (setq last nl from (1+ nl)))
        (if last (setq found (+ start last 1)) (setq end start))))
    (or found 0)))

(defun ngit-grep--find-literal (pattern data pos)
  "Find PATTERN at or after POS without rescanning a large string per hit."
  (let ((size (length data)) (overlap (max 0 (1- (length pattern)))) (found nil))
    (while (and (< pos size) (not found))
      (let* ((end (min size (+ pos 16384 overlap)))
             (hit (string-search pattern (substring data pos end))))
        (if hit (setq found (+ pos hit)) (setq pos (+ pos 16384)))))
    found))

(defun ngit-grep--line-end (data pos)
  (let ((size (length data)) (found nil))
    (while (and (< pos size) (not found))
      (let* ((end (min size (+ pos 4096)))
             (nl (string-search "\n" (substring data pos end))))
        (if nl (setq found (+ pos nl)) (setq pos end))))
    (or found size)))

(defun ngit-grep--literal (data pattern name number count list-files quiet no-name null)
  "Search one literal without allocating per-line expression masks."
  (cond
   ((or list-files quiet)
    (when (and list-files (not quiet)) (ngit--emit name (if null "\0" "\n"))) t)
   ((and (not number) (not count))
    (let ((pos 0) (hits nil) (match nil)
          (size (length data)) (prefix (if no-name "" (concat name (if null "\0" ":")))))
      (while (and (< pos size) (setq match (ngit-grep--find-literal pattern data pos)))
        (let ((begin (ngit-grep--line-start data match))
              (end (ngit-grep--line-end data match)))
          (ngit--emit prefix (substring data begin end) "\n") (setq hits t)
          (setq pos (1+ end))))
      hits))
   (t
    (let ((lines (ngit-lines data)) (line-number 0) (hits 0)
          (prefix (if no-name "" (concat name (if null "\0" ":")))))
      (while lines
        (let ((line (pop lines)))
          (setq line-number (1+ line-number))
          (when (and (or lines (not (string= line ""))) (string-search pattern line))
            (setq hits (1+ hits))
            (unless count
              (ngit--emit prefix)
              (when number (ngit--emit (number-to-string line-number) ":"))
              (ngit--emit line "\n")))))
      (when (and count (> hits 0)) (ngit--emit prefix (number-to-string hits) "\n"))
      (> hits 0)))))

(defun ngit-grep--word-p (ch)
  (or (and (>= ch ?a) (<= ch ?z)) (and (>= ch ?A) (<= ch ?Z))
      (and (>= ch ?0) (<= ch ?9)) (= ch ?_) (and (>= ch 128) (= (char-syntax ch) ?w))))

(defun ngit-grep--masks (data lines patterns word)
  "Mark pattern hits by line, searching each regexp over DATA only once."
  (let* ((n (length lines)) (starts (make-vector (1+ n) 0))
         (masks (make-vector n 0)) (offset 0) (bit 1))
    (dotimes (i n)
      (aset starts i offset) (setq offset (+ offset (length (aref lines i)) 1)))
    (aset starts n (1+ (length data)))
    (dolist (pat patterns)
      (let ((pos 0) (line 0) (done nil) (limit (length data)))
        (while (and (not done) (<= pos limit) (string-match pat data pos))
          (let ((begin (match-beginning 0)) (end (match-end 0)))
            (while (and (< line n) (>= begin (aref starts (1+ line)))) (setq line (1+ line)))
            (when (and (< line n) (<= end (1- (aref starts (1+ line))))
                       (or (not word)
                           (and (< begin end)
                                (or (= begin 0) (not (ngit-grep--word-p (aref data (1- begin)))))
                                (or (= end limit) (not (ngit-grep--word-p (aref data end)))))))
              (aset masks line (logior (aref masks line) bit)))
            ;; Once a line matched this pattern, skip its remaining matches.
            (setq pos (if (and (< line n) (/= (aref masks line) 0)
                               (/= 0 (logand (aref masks line) bit)))
                          (aref starts (1+ line))
                        (max (1+ begin) end)))
            (when (> pos limit) (setq done t)))))
      (setq bit (ash bit 1)))
    masks))

(defun ngit-grep--tree (repo bin prefix paths)
  (let ((ngit--rv-paths paths) (files nil))
    (dolist (e (ngit-parse-tree (ngit--tree-data repo bin)))
      (let* ((path (concat prefix (nth 1 e))) (mode (car e))
             (dirp (string= mode "40000"))
             (match (or (null paths) (ngit--ps-class path dirp))))
        (when match
          (cond (dirp (setq files (append files (ngit-grep--tree repo (nth 2 e) (concat path "/") paths))))
                ((member mode '("100644" "100755")) (push (cons path (nth 2 e)) files))))))
    ;; Recursion and leaves are sorted together in git tree order below.
    (sort files (lambda (a b) (string< (car a) (car b))))))

(defun ngit-grep--disk-data (index entry)
  "Read a tracked regular file using the index's native C path when possible."
  (let* ((native (and (/= (aref index 2) 4) (aref index 6)))
         (pos (aref entry 4))
         (cpath (and native (+ native pos
                              (if (= 0 (logand (aref (aref index 1) (+ pos 60)) #x40)) 62 64))))
         (st (if cpath (ngit-wt-lstat-at cpath) (ngit-wt-lstat (aref entry 0)))))
    (when (and st (= (logand (aref st 0) ngit-s-ifmt) ngit-s-ifreg))
      (if (not cpath) (ngit-wt-read (aref entry 0) (aref st 2))
        (let ((fd (syscall-direct 257 (ngit-wt--top-fd) cpath ngit-native--o-rdonly-cloexec 0 0 0))
              (size (aref st 2)))
          (when (< fd 0) (ngit--die "fatal: cannot open %s" (aref entry 0)))
          (unwind-protect
              (let* ((buf (ngit-native--buffer 0 (max size 1))) (addr (nl-ffi-memory-address buf))
                     (done 0) (eof nil))
                (while (and (< done size) (not eof))
                  (let ((n (syscall-direct ngit-native--sys-pread64 fd (+ addr done) (- size done) done 0 0)))
                    (if (<= n 0) (setq eof t) (setq done (+ done n)))))
                (ptr-read-bytes addr done))
            (syscall-direct ngit-native--sys-close fd 0 0 0 0 0)))))))

(defun ngit-cmd-grep (repo args)
  (let ((number nil) (icase nil) (word nil) (invert nil) (list-files nil)
        (count nil) (cached nil) (mode 'basic) (patterns nil) (tokens nil)
        (rest nil) (paths nil) (trees nil) (pattern-given nil) (done nil)
        (quiet nil) (text nil) (no-name nil) (null nil) (pattern-count 0) (literals nil))
    (while (and args (not done))
      (let ((a (pop args)))
        (cond
         ((string= a "--") (setq rest args args nil done t))
         ((member a '("--and" "--or" "--not" "(" ")"))
          (push (cond ((string= a "--and") 'and) ((string= a "--or") 'or)
                      ((string= a "--not") 'not) ((string= a "(") 'open) (t 'close)) tokens))
         ((or (string= a "-e")
              (and (string-prefix-p "-e" a) (> (length a) 2)))
          (let ((pat (cond ((and (string-prefix-p "-e" a) (> (length a) 2)) (substring a 2))
                           (t (or (pop args) (ngit--die-with 129 "error: -e requires a value"))))))
            (dolist (p (split-string pat "\n"))
              (push p patterns) (push pattern-count tokens) (setq pattern-count (1+ pattern-count)))
            (setq pattern-given t)))
         ((member a '("--cached" "--ignore-case" "--word-regexp" "--invert-match" "--line-number"
                      "--files-with-matches" "--count" "--extended-regexp" "--fixed-strings" "--basic-regexp"))
          (cond ((string= a "--cached") (setq cached t))
                ((string= a "--ignore-case") (setq icase t))
                ((string= a "--word-regexp") (setq word t))
                ((string= a "--invert-match") (setq invert t))
                ((string= a "--line-number") (setq number t))
                ((string= a "--files-with-matches") (setq list-files t))
                ((string= a "--count") (setq count t))
                ((string= a "--extended-regexp") (setq mode 'extended))
                ((string= a "--fixed-strings") (setq mode 'fixed))
                (t (setq mode 'basic))))
         ((and (string-prefix-p "-" a) (> (length a) 1) (/= (aref a 1) ?-))
          (dolist (ch (string-to-list (substring a 1)))
            (pcase ch
              (?n (setq number t)) (?i (setq icase t)) (?w (setq word t)) (?v (setq invert t))
              (?l (setq list-files t)) (?c (setq count t)) (?E (setq mode 'extended))
              (?F (setq mode 'fixed)) (?G (setq mode 'basic)) (?q (setq quiet t))
              (?a (setq text t)) (?h (setq no-name t)) (?z (setq null t))
              (_ (ngit--die-with 129 "error: unknown grep option %s" a)))))
         ((string-prefix-p "-" a) (ngit--die-with 129 "error: unknown grep option %s" a))
         ((not pattern-given)
          (dolist (p (split-string a "\n"))
            (push p patterns) (push pattern-count tokens) (setq pattern-count (1+ pattern-count)))
          (setq pattern-given t))
         (t (setq rest (cons a args) args nil done t)))))
    (unless pattern-given (ngit--die-with 129 "fatal: no pattern given"))
    (while rest
      (let ((a (pop rest)))
        (cond ((string= a "--") (setq paths (append paths rest) rest nil))
              ((and (null paths) (condition-case nil (ngit-rev-parse repo a) (error nil)))
               (push a trees))
              (t (setq paths (append paths (list a) rest) rest nil)))))
    (when (and trees cached) (ngit--die "fatal: both --cached and trees are given"))
    (setq patterns (mapcar (lambda (p) (if (multibyte-string-p p) (encode-coding-string p 'utf-8) p)) patterns))
    (when (and (not icase) (or (eq mode 'fixed) (seq-every-p #'ngit-grep--plain-p patterns)))
      (setq literals (nreverse (copy-sequence patterns))))
    (setq patterns (mapcar (lambda (p) (ngit-grep--regexp p mode)) (nreverse patterns))
          paths (mapcar (lambda (p) (ngit--ps-item (if (multibyte-string-p p) (encode-coding-string p 'utf-8) p))) paths))
    (let* ((ngit-grep--tokens (nreverse tokens)) (expr (ngit-grep--or))
           (files nil) (case-fold-search icase) (hit-any nil) (index nil))
      (when ngit-grep--tokens (ngit--die "fatal: invalid grep expression"))
      (if trees
          (dolist (tree (nreverse trees))
            (dolist (f (ngit-grep--tree repo (ngit-unhex (ngit-peel repo (ngit-rev-parse repo tree) 'tree)) "" paths))
              (push (vector (car f) (cdr f) (car f) tree nil) files)))
        (setq index (ngit-read-index repo))
        (unless cached (ngit-wt-setup (ngit-repo-toplevel repo)))
        (let ((entries (aref index 0)) (ngit--rv-paths paths) (prev nil))
          (dotimes (i (length entries))
            (let* ((e (aref entries i)) (path (aref e 0)))
              (when (and (not (equal prev path)) (memq (aref e 2) '(#o100644 #o100755))
                         (or (null paths) (eq (ngit--ps-class path nil) 'full)))
                (push (vector path (and cached (aref e 1)) path nil e) files))
              (setq prev path)))))
      (dolist (file (nreverse files))
        (let* ((name (aref file 0)) (bin (aref file 1))
               (data (if bin (cdr (ngit-read-object repo bin))
                       (ngit-grep--disk-data index (aref file 4))))
               (regex-data (and data (not literals) (decode-coding-string data 'utf-8))))
          (when (and data
                     (or invert (ngit-grep--negative-p expr)
                         (catch 'match
                           (dolist (pat (or literals patterns))
                             (when (if literals (string-search pat data) (string-match-p pat regex-data))
                               (throw 'match t)))
                           nil)))
            (let ((binary (and (not text) (ngit--binary-p repo (aref file 2) data))))
              (if (and binary literals (not word) (not invert) (not count)
                       (ngit-grep--lookahead-p expr))
                  (progn
                    (setq hit-any t name (concat (if (aref file 3) (concat (aref file 3) ":") "")
                                                (if null (aref file 2) (ngit-quote-path (aref file 2)))))
                    (cond (quiet nil) (list-files (ngit--emit name (if null "\0" "\n")))
                          (t (ngit--emit "Binary file " name " matches\n"))))
                (if (and (not binary) literals (= (length literals) 1) (integerp expr)
                         (not word) (not invert))
                    (when (ngit-grep--literal
                           data (car literals)
                           (concat (if (aref file 3) (concat (aref file 3) ":") "")
                                   (if null (aref file 2) (ngit-quote-path (aref file 2))))
                           number count list-files quiet no-name null)
                      (setq hit-any t))
            (let* ((lines (vconcat (ngit-lines data)))
                   (search-data (or regex-data (decode-coding-string data 'utf-8)))
                   (search-lines (if (= (length search-data) (length data)) lines
                                   (vconcat (ngit-lines search-data))))
                   (n (- (length lines) (if (or (string= data "") (string-suffix-p "\n" data)) 1 0)))
                   (masks (ngit-grep--masks search-data search-lines patterns word))
                   (matches nil) (total 0))
              ;; Git's look_ahead may advance to the final NUL for an empty
              ;; match after an unmatched last line (grep.c, Git 2.47.3).
              (when (and (> n 0) (< n (length lines)) (not invert)
                         (ngit-grep--lookahead-p expr)
                         (not (ngit-grep--eval expr (aref masks (1- n))))
                         (ngit-grep--eval expr (aref masks n)))
                (setq n (1+ n)))
              (dotimes (i n)
                (when (if invert (not (ngit-grep--eval expr (aref masks i)))
                        (ngit-grep--eval expr (aref masks i)))
                  (setq total (1+ total)) (push i matches)))
              (when (> total 0)
                (setq name (concat (if (aref file 3) (concat (aref file 3) ":") "")
                                   (if null (aref file 2) (ngit-quote-path (aref file 2)))))
                (setq hit-any t)
                (cond (quiet nil)
                      (list-files (ngit--emit name (if null "\0" "\n")))
                      (count (ngit--emit (if no-name "" (concat name (if null "\0" ":")))
                                         (number-to-string total) "\n"))
                      (binary (ngit--emit "Binary file " name " matches\n"))
                      (t (dolist (i (nreverse matches))
                           (unless no-name (ngit--emit name (if null "\0" ":")))
                           (when number (ngit--emit (number-to-string (1+ i)) ":"))
                           (ngit--emit (aref lines i) "\n"))))))))))
          ;; Bound pending output by file; generated single-line sources can
          ;; otherwise retain hundreds of megabytes until the command exits.
          (ngit--flush)))
      (if hit-any 0 1))))

(provide 'ngit-grep)
;;; ngit-grep.el ends here
