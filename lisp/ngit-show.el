;;; ngit-show.el --- object display and dense combined diffs -*- lexical-binding: t; -*-

;;; Commentary:

;; builtin/log.c's cmd_show dispatch, reusing log's revision walk and
;; pretty printer.  Combined diffs follow combine-diff.c: intersect the
;; parent paths, coalesce lost lines, discard uninteresting dense hunks,
;; then paint context and emit one column per parent.

;;; Code:

(require 'ngit-log)

;;;; Dense combined patches

(defun ngit--cc-coalesce (base added mask)
  "Merge ADDED lines into BASE's (TEXT . PARENT-MASK) lines by LCS.
Ties choose NEW, as in combine-diff.c's coalesce_lines."
  (if (null base)
      (mapcar (lambda (s) (cons s mask)) added)
    (let* ((a (vconcat base)) (b (vconcat added))
           (na (length a)) (nb (length b))
           (rows (make-vector (1+ na) nil)) (i 0) (out nil))
      (while (<= i na)
        (aset rows i (make-vector (1+ nb) 0)) (setq i (1+ i)))
      (setq i 1)
      (while (<= i na)
        (let ((j 1) (row (aref rows i)) (prev (aref rows (1- i))))
          (while (<= j nb)
            (aset row j (if (string= (car (aref a (1- i))) (aref b (1- j)))
                            (1+ (aref prev (1- j)))
                          (max (aref row (1- j)) (aref prev j))))
            (setq j (1+ j))))
        (setq i (1+ i)))
      (let ((j nb))
        (setq i na)
        (while (or (> i 0) (> j 0))
          (cond
           ((and (> i 0) (> j 0)
                 (string= (car (aref a (1- i))) (aref b (1- j))))
            (let ((line (aref a (1- i))))
              (push (cons (car line) (logior (cdr line) mask)) out))
            (setq i (1- i) j (1- j)))
           ((and (> j 0) (or (= i 0)
                             (>= (aref (aref rows i) (1- j))
                                 (aref (aref rows (1- i)) j))))
            (push (cons (aref b (1- j)) mask) out) (setq j (1- j)))
           (t (push (aref a (1- i)) out) (setq i (1- i))))))
      out)))

(defun ngit--cc-parent (old new flags lost lnos parent)
  "Consume a zero-context xdiff for PARENT into the combined line arrays."
  (let ((lines (split-string (ngit-xdiff-unified old new 0) "\n"))
        (mask (ash 1 parent)) (pos 0) (bucket 0)
        (pending (make-hash-table :test 'eql)) (buckets nil))
    (dolist (line lines)
      (when (> (length line) 0)
        (cond
         ((= (aref line 0) ?@)
          (let* ((start (1+ (string-search "+" line)))
                 (end (string-search " " line start))
                 (comma (string-search "," line start))
                 (count (if (and comma (< comma end))
                            (string-to-number (substring line (1+ comma) end)) 1)))
            (setq pos (string-to-number (substring line start end))
                  bucket (if (= count 0) pos (1- pos)))
            (unless (= count 0) (setq pos (1- pos)))))
         ((= (aref line 0) ?-)
          (unless (gethash bucket pending) (push bucket buckets))
          (puthash bucket (cons (substring line 1) (gethash bucket pending)) pending))
         ((= (aref line 0) ?+)
          (aset flags pos (logior (aref flags pos) mask))
          (setq pos (1+ pos))))))
    (dolist (b buckets)
      (aset lost b (ngit--cc-coalesce (aref lost b) (nreverse (gethash b pending)) mask)))
    (let ((i 0) (p 1) (cnt (- (length flags) 2)))
      (while (<= i cnt)
        (aset lnos i p)
        (dolist (line (aref lost i))
          (when (/= (logand (cdr line) mask) 0) (setq p (1+ p))))
        (when (and (< i cnt) (= (logand (aref flags i) mask) 0)) (setq p (1+ p)))
        (setq i (1+ i)))
      (aset lnos i p))))

(defun ngit--cc-next (flags mark i cnt uninteresting)
  (while (and (<= i cnt)
              (if uninteresting (/= (logand (aref flags i) mark) 0)
                (= (logand (aref flags i) mark) 0)))
    (setq i (1+ i)))
  i)

(defun ngit--cc-tail (flags all begin end)
  (if (and (<= (1+ begin) end) (= (logand (aref flags (1- end)) all) 0))
      (1- end) end))

(defun ngit--cc-hunks (flags lost cnt parents)
  "Port make_hunks and give_context, with dense combined always enabled."
  (let* ((mark (ash 1 parents)) (all (1- mark)) (no-delete (* 2 mark))
         (ctx ngit--ld-context) (i 0))
    (while (<= i cnt)
      (when (or (/= (logand (aref flags i) all) 0) (aref lost i))
        (aset flags i (logior (aref flags i) mark)))
      (setq i (1+ i)))
    (setq i 0)
    (while (<= i cnt)
      (setq i (ngit--cc-next flags mark i cnt nil))
      (when (<= i cnt)
        (let ((j (1+ i)) (same 0) (interesting nil) (done nil))
          (while (and (<= j cnt) (not done))
            (if (/= (logand (aref flags j) mark) 0)
                (setq j (1+ j))
              (let* ((la (min (1+ cnt) (+ ctx (ngit--cc-tail flags all i j))))
                     (found nil))
                (while (and (> la j) (not found))
                  (setq la (1- la))
                  (when (/= (logand (aref flags la) mark) 0) (setq found t)))
                (if found (setq j (1+ la)) (setq done t)))))
          (let ((k i))
            (while (and (< k j) (not interesting))
              (let ((diff (logand (aref flags k) all)))
                (when (/= diff 0)
                  (if (= same 0) (setq same diff)
                    (unless (= same diff) (setq interesting t)))))
              (dolist (line (aref lost k))
                (if (= same 0) (setq same (cdr line))
                  (unless (= same (cdr line)) (setq interesting t))))
              (setq k (1+ k)))
            (unless (or interesting (= same all))
              (setq k i)
              (while (< k j)
                (aset flags k (logand (aref flags k) (lognot mark)))
                (setq k (1+ k)))))
          (setq i j))))
    ;; Context is painted only after the dense test, including the
    ;; NO_PRE_DELETE bit on leading context from discarded hunks.
    (setq i (ngit--cc-next flags mark 0 cnt nil))
    (let ((found (<= i cnt)))
      (while (<= i cnt)
        (let ((j (max 0 (- i ctx))) (again t))
          (while (< j i)
            (when (= (logand (aref flags j) mark) 0)
              (aset flags j (logior (aref flags j) no-delete)))
            (aset flags j (logior (aref flags j) mark)) (setq j (1+ j)))
          (while again
            (setq j (ngit--cc-next flags mark i cnt t))
            (if (> j cnt)
                (setq i (1+ cnt) again nil)
              (let ((k (ngit--cc-next flags mark j cnt nil)))
                (setq j (ngit--cc-tail flags all i j))
                (if (< k (+ j ctx))
                    (progn
                      (while (< j k)
                        (aset flags j (logior (aref flags j) mark)) (setq j (1+ j)))
                      (setq i k))
                  (setq i k k (min (1+ cnt) (+ j ctx)) again nil)
                  (while (< j k)
                    (aset flags j (logior (aref flags j) mark)) (setq j (1+ j)))))))))
      found)))

(defun ngit--cc-prefix (mask parents char)
  (let ((s (make-string parents ?\s)) (i 0))
    (while (< i parents)
      (when (/= (logand mask (ash 1 i)) 0) (aset s i char))
      (setq i (1+ i)))
    s))

(defun ngit--cc-dump (recs flags lost lnos parents)
  "Emit dump_sline's marked hunks, including parent line ranges."
  (let* ((cnt (length recs)) (mark (ash 1 parents)) (all (1- mark))
         (ats (make-string (1+ parents) ?@)) (i 0))
    (while (<= i cnt)
      (let ((comment nil))
        (while (and (<= i cnt) (= (logand (aref flags i) mark) 0))
          (when (< i cnt)
            (let* ((s (aref recs i)) (ch (and (> (length s) 0) (aref s 0))))
              (when (and ch (or (and (>= ch ?a) (<= ch ?z))
                                (and (>= ch ?A) (<= ch ?Z)) (memq ch '(?_ ?$))))
                (setq comment s))))
          (setq i (1+ i)))
        (when (<= i cnt)
          (let* ((end (ngit--cc-next flags mark (1+ i) cnt t))
                 (rlines (- (min end cnt) i)) (null-context 0) (p 0))
            (when (= ngit--ld-context 0)
              (let ((j i))
                (while (< j end)
                  (when (= (logand (aref flags j) all) 0)
                    (setq null-context (1+ null-context)))
                  (setq j (1+ j))))
              (setq rlines (- rlines null-context)))
            (ngit--emit ats)
            (while (< p parents)
              (let* ((nums (aref lnos p)) (start (aref nums i)))
                (ngit--emit (format " -%d,%d" start (- (aref nums end) start null-context))))
              (setq p (1+ p)))
            (ngit--emit (format " +%d," (1+ i))
                        ;; Match C's unsigned long when -U0 subtracts the
                        ;; sentinel line from an empty result hunk.
                        (if (< rlines 0) "18446744073709551615" (number-to-string rlines))
                        " " ats)
            (when comment
              ;; combine-diff's comment_end is the last nonspace index,
              ;; and the output deliberately excludes that last byte.
              (let ((s (ngit--rtrim (substring comment 0 (min 40 (length comment))))))
                (when (> (length s) 1) (ngit--emit " " (substring s 0 -1)))))
            (ngit--emit "\n")
            (while (< i end)
              (unless (/= (logand (aref flags i) (* 2 mark)) 0)
                (dolist (line (aref lost i))
                  (ngit--emit (ngit--cc-prefix (cdr line) parents ?-) (car line) "\n")))
              (when (and (< i cnt)
                         (or (> ngit--ld-context 0) (/= (logand (aref flags i) all) 0)))
                (ngit--emit (ngit--cc-prefix (logand (aref flags i) all) parents ?+)
                            (aref recs i) "\n"))
              (setq i (1+ i)))))))))

(defun ngit--cc-patch (repo pairs)
  "Emit a combined patch for one path's parent change PAIRS."
  (let* ((first (car pairs)) (path (aref first 0))
         (mode (aref first 4)) (bin (aref first 5))
         (new (ngit--diff-blob repo mode bin))
         (parents (length pairs)) (old nil) (mode-diff nil) (added t)
         (binary (ngit--binary-p repo path new)))
    (dolist (c pairs)
      (let ((s (ngit--diff-blob repo (aref c 2) (aref c 3))))
        (push s old)
        (when (ngit--binary-p repo path s) (setq binary t)))
      (unless (= mode (aref c 2)) (setq mode-diff t))
      (unless (= (aref c 1) ?A) (setq added nil)))
    (setq old (nreverse old))
    (let* ((recs (vconcat (ngit--message-lines new))) (cnt (length recs))
           (flags (make-vector (+ cnt 2) 0)) (lost (make-vector (+ cnt 2) nil))
           (lnos (make-vector parents nil)) (p 0) (hunks nil))
      (unless binary
        (dolist (s old)
          (let ((nums (make-vector (+ cnt 2) 0)))
            (aset lnos p nums)
            (ngit--cc-parent s new flags lost nums p))
          (setq p (1+ p)))
        (setq hunks (ngit--cc-hunks flags lost cnt parents)))
      (when (or binary mode-diff hunks)
        (ngit--emit "diff --cc " (ngit-quote-path path) "\nindex "
                    (mapconcat (lambda (c) (ngit--abbrev-bin repo (aref c 3))) pairs ",")
                    ".." (ngit--abbrev-bin repo bin) "\n")
        (when mode-diff
          (if added (ngit--emit "new file mode " (ngit--octal6 mode))
            (ngit--emit (if bin "mode " "deleted file mode ")
                        (mapconcat (lambda (c) (ngit--octal6 (aref c 2))) pairs ",")
                        (if bin (concat ".." (ngit--octal6 mode)) "")))
          (ngit--emit "\n"))
        (if binary (ngit--emit "Binary files differ\n")
          (ngit--emit "--- " (if added "/dev/null" (ngit-quote-path (concat "a/" path)))
                      "\n+++ " (if bin (ngit-quote-path (concat "b/" path)) "/dev/null") "\n")
          (when hunks (ngit--cc-dump recs flags lost lnos parents)))))))

(defun ngit--show-merge-diff (repo c)
  "Combined name/patch output; statistics compare against the first parent."
  (let ((parent-changes nil) (fmts ngit--ld-formats))
    (dolist (p (ngit--c-parents c))
      (ngit--parse p)
      (let ((ngit--rv-first-parent t))
        ;; Reuse path filtering and diffcore-rename for every parent.
        (let ((parents (ngit--c-parents c)))
          (unwind-protect
              (progn (aset c 2 (list p)) (push (ngit--log-changes repo c) parent-changes))
            (aset c 2 parents)))))
    (setq parent-changes (nreverse parent-changes))
    (let ((paths nil) (table (make-hash-table :test 'equal))
          (nparents (length parent-changes)))
      (dolist (ch (car parent-changes))
        (push (aref ch 0) paths) (puthash (aref ch 0) (list ch) table))
      (dolist (changes (cdr parent-changes))
        (dolist (ch changes)
          (let ((prev (gethash (aref ch 0) table)))
            (when prev (puthash (aref ch 0) (cons ch prev) table)))))
      (setq paths (nreverse paths))
      (let ((ngit--ld-formats (seq-filter (lambda (f) (memq f '(stat shortstat numstat summary))) fmts)))
        (when ngit--ld-formats (ngit--emit-log-diff repo (car parent-changes))))
      (let ((surviving nil))
        (dolist (path paths)
          (let ((pairs (gethash path table)))
            (when (= (length pairs) nparents) (push (nreverse pairs) surviving))))
        (setq surviving (nreverse surviving))
        (when (or (memq 'name-only fmts) (memq 'name-status fmts))
          (dolist (pairs surviving)
            (when (memq 'name-status fmts)
              (ngit--emit (mapconcat (lambda (ch) (string (aref ch 1))) pairs "") "\t"))
            (ngit--emit (ngit-quote-path (aref (car pairs) 0)) "\n")))
        (when (memq 'patch fmts)
          (when (and surviving (seq-some (lambda (f) (memq f '(stat shortstat numstat name-only name-status))) fmts))
            (ngit--emit "\n"))
          (dolist (pairs surviving) (ngit--cc-patch repo pairs)))))))

;;;; Object dispatch

(defun ngit--show-tag-format (spec)
  "The pp_user_info style associated with pretty format SPEC."
  (if (null spec) 'medium
    (if (or (string= spec "") (string-search "%" spec)
            (string-prefix-p "format:" spec) (string-prefix-p "tformat:" spec))
        'user
      (let ((found nil))
        (dolist (name '("raw" "medium" "short" "fuller" "full" "oneline" "reference"))
          (when (and (string-prefix-p (downcase spec) name)
                     (or (null found) (< (length name) (length found))))
            (setq found name)))
        (if (and found (not (string= found "reference"))) (intern found) 'user)))))

(defun ngit--show-object (repo hex name opts paths tag-format date-mode)
  "Display HEX, retaining NAME for tree headers through tag chains."
  (let ((obj (ngit-read-object repo (ngit-unhex hex))))
    (pcase (car obj)
      ('blob (ngit--emit (cdr obj)))
      ('tree
       (when (aref ngit--log-show-state 0) (ngit--emit "\n"))
       (ngit--emit "tree " name "\n\n")
       (dolist (e (ngit-parse-tree (cdr obj)))
         (ngit--emit (nth 1 e) (if (string= (ngit-mode-type (car e)) "tree") "/" "") "\n"))
       (aset ngit--log-show-state 0 t))
      ('tag
       (let* ((parsed (ngit-parse-commit (cdr obj)))
              (tagger (ngit-header parsed "tagger")))
         (when (aref ngit--log-show-state 0) (ngit--emit "\n"))
         (ngit--emit "tag " (ngit-header parsed "tag") "\n")
         (when (and tagger (not (eq tag-format 'oneline)))
           (ngit--emit (ngit--pp-user "Tagger" tagger tag-format date-mode)))
         (ngit--emit "\n" (plist-get parsed :message))
         (aset ngit--log-show-state 0 t)
         (ngit--show-object repo (ngit-header parsed "object") name opts paths tag-format date-mode)))
      ('commit
       (ngit-cmd-log repo (append opts (list hex) paths))))))

;;;###autoload
(defun ngit-cmd-show (repo args)
  "Display objects in command-line order, or walk an explicit range."
  (let ((opts nil) (objects nil) (paths nil) (walk nil) (diff-given nil)
        (tag-format (ngit--show-tag-format (ngit-config-get repo "format.pretty")))
        (date-mode '(normal))
        (ngit--commit-table (make-hash-table :test 'equal))
        (ngit--log-show-state (vector nil t)))
    (let ((cfg (ngit-config-get repo "log.date")))
      (when cfg (setq date-mode (ngit-parse-date-mode cfg))))
    (while args
      (let ((a (pop args)))
        (cond
         ((string= a "--") (setq paths (cons "--" args) args nil))
         ((string-prefix-p ":(" a) (setq paths (cons "--" (cons a args)) args nil))
         ((member a '("--cc" "--no-walk" "--no-walk=unsorted" "--no-walk=sorted")))
         ((string= a "--do-walk") (setq walk t))
         ((string-prefix-p "-" a)
          (push a opts)
          (when (or (member a '("--all" "--branches" "--tags" "--remotes" "--not" "-n" "--max-count"))
                    (string-prefix-p "--max-count=" a) (string-prefix-p "-n" a)
                    (string-prefix-p "--branches=" a) (string-prefix-p "--tags=" a)
                    (string-prefix-p "--remotes=" a)
                    (and (> (length a) 1) (>= (aref a 1) ?0) (<= (aref a 1) ?9)))
            (setq walk t))
          (when (or (member a '("-p" "-u" "--patch" "-s" "--no-patch" "-q" "--quiet"
                                 "--stat" "--shortstat" "--numstat" "--name-only" "--name-status" "--summary"))
                    (string-prefix-p "-U" a) (string-prefix-p "--unified=" a))
            (setq diff-given t))
          (cond
           ((string= a "--oneline") (setq tag-format 'oneline))
           ((member a '("--pretty" "--format")) (setq tag-format 'medium))
           ((or (string-prefix-p "--format=" a) (string-prefix-p "--pretty=" a))
            (let ((spec (substring a (1+ (string-search "=" a)))))
              (setq tag-format (ngit--show-tag-format spec))))
           ((string-prefix-p "--date=" a) (setq date-mode (ngit-parse-date-mode (substring a 7)))))
          (when (member a '("-n" "--max-count" "--skip" "--date" "--since" "--after" "--until"
                             "--before" "--author" "--committer" "--grep"))
            (when args
              (let ((v (pop args)))
                (push v opts)
                (when (string= a "--date") (setq date-mode (ngit-parse-date-mode v)))))))
         (t
          (if (and (not (member "--" args))
                   (file-exists-p (expand-file-name a (or ngit--invocation-directory default-directory)))
                   (let ((resolved (condition-case err (ngit-rev-parse repo a)
                                     (error
                                      (let ((message (error-message-string err)))
                                        ;; A missing tree path is unresolved revision
                                        ;; syntax too; retain corruption/ref errors.
                                        (if (or (string-prefix-p "fatal: ambiguous argument" message)
                                                (and (string-prefix-p "fatal: path " message)
                                                     (string-search " does not exist in " message)))
                                            nil
                                          (signal (car err) (cdr err))))))))
                     (when resolved
                       (ngit--die "fatal: ambiguous argument '%s': both revision and filename\nUse '--' to separate paths from revisions, like this:\n'git <command> [<revision>...] -- [<file>...]'" a))
                     (not resolved)))
              ;; As in log, everything after the first path is a path.
              (progn
                (dolist (rest args)
                  (unless (file-exists-p (expand-file-name rest (or ngit--invocation-directory default-directory)))
                    (ngit--die "fatal: %s: no such path in the working tree.\nUse 'git <command> -- <path>...' to specify paths that do not exist locally." rest)))
                (setq paths (cons "--" (cons a args)) args nil))
            (unless (string-search ":" a)
              (when (or (string-search ".." a) (string-prefix-p "^" a)
                        (string-suffix-p "^!" a) (string-suffix-p "^@" a)) (setq walk t)))
            (push a objects))))))
    (setq opts (nreverse opts) objects (nreverse objects))
    (unless diff-given (setq opts (cons "-p" opts)))
    (if walk
        (progn
          (aset ngit--log-show-state 1 nil)
          (ngit-cmd-log repo (append opts objects paths)))
      (unless objects (setq objects '("HEAD")))
      ;; Resolve every argument before producing output, as setup_revisions.
      (let ((pending nil) (seen (make-hash-table :test 'equal)))
        (dolist (name objects)
          (let* ((colon (string-search ":" name))
                 (path (and colon (substring name (1+ colon))))
                 ;; revision:path stays root-relative, except Git's explicit
                 ;; ./ and ../ spellings which use the invocation directory.
                 (spec (if (and path (or (string-prefix-p "./" path)
                                         (string-prefix-p "../" path)))
                           (concat (encode-coding-string (substring name 0 (1+ colon)) 'utf-8)
                                   (car (ngit-paths-items repo (list path))))
                         (if colon (encode-coding-string name 'utf-8) name)))
                 (hex (condition-case err (ngit-rev-parse repo spec)
                       (error
                        (if (string-prefix-p "fatal: ambiguous argument" (error-message-string err))
                            (if paths (ngit--die "fatal: bad revision '%s'" name)
                              (ngit--bad-revision name))
                          (signal (car err) (cdr err)))))))
            (unless hex (ngit--bad-revision name))
            (unless (ngit-object-exists-p repo (ngit-unhex hex))
              (ngit--die "fatal: bad object %s" name))
            (unless (gethash hex seen)
              (puthash hex t seen) (push (cons hex name) pending))))
        (dolist (entry (nreverse pending))
          (ngit--show-object repo (car entry) (cdr entry) opts paths tag-format date-mode))))
    0))

(provide 'ngit-show)

;;; ngit-show.el ends here
