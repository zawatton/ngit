;;; ngit-transport-kernel-source.el --- raw delta kernel source -*- lexical-binding: t; -*-

(defun ngitDeltaKernel (base base-len delta delta-len output output-len)
  (let ((p 0) (value 0) (factor 1) (byte 128) (count 0) (status 0)
        (written 0) (command 0) (offset 0) (size 0) (i 0))
    (while (and (= status 0) (/= 0 (logand byte 128)))
      (if (or (>= p delta-len) (>= count 9))
          (setq status 1)
        (setq byte (ptr-read-u8 delta p)
              p (+ p 1)
              value (+ value (* factor (logand byte 127)))
              count (+ count 1))
        (when (/= 0 (logand byte 128))
          (if (>= count 9) (setq status 1) (setq factor (* factor 128))))))
    (when (and (= status 0) (/= value base-len)) (setq status 2))
    (setq value 0 factor 1 byte 128 count 0)
    (while (and (= status 0) (/= 0 (logand byte 128)))
      (if (or (>= p delta-len) (>= count 9))
          (setq status 1)
        (setq byte (ptr-read-u8 delta p)
              p (+ p 1)
              value (+ value (* factor (logand byte 127)))
              count (+ count 1))
        (when (/= 0 (logand byte 128))
          (if (>= count 9) (setq status 1) (setq factor (* factor 128))))))
    (when (and (= status 0) (/= value output-len)) (setq status 3))
    (while (and (= status 0) (< p delta-len))
      (setq command (ptr-read-u8 delta p) p (+ p 1))
      (if (/= 0 (logand command 128))
          (progn
            (setq offset 0 size 0)
            (when (/= 0 (logand command 1))
              (if (>= p delta-len) (setq status 4)
                (setq offset (ptr-read-u8 delta p) p (+ p 1))))
            (when (and (= status 0) (/= 0 (logand command 2)))
              (if (>= p delta-len) (setq status 4)
                (setq offset (+ offset (* (ptr-read-u8 delta p) 256)) p (+ p 1))))
            (when (and (= status 0) (/= 0 (logand command 4)))
              (if (>= p delta-len) (setq status 4)
                (setq offset (+ offset (* (ptr-read-u8 delta p) 65536)) p (+ p 1))))
            (when (and (= status 0) (/= 0 (logand command 8)))
              (if (>= p delta-len) (setq status 4)
                (setq offset (+ offset (* (ptr-read-u8 delta p) 16777216)) p (+ p 1))))
            (when (and (= status 0) (/= 0 (logand command 16)))
              (if (>= p delta-len) (setq status 4)
                (setq size (ptr-read-u8 delta p) p (+ p 1))))
            (when (and (= status 0) (/= 0 (logand command 32)))
              (if (>= p delta-len) (setq status 4)
                (setq size (+ size (* (ptr-read-u8 delta p) 256)) p (+ p 1))))
            (when (and (= status 0) (/= 0 (logand command 64)))
              (if (>= p delta-len) (setq status 4)
                (setq size (+ size (* (ptr-read-u8 delta p) 65536)) p (+ p 1))))
            (when (= size 0) (setq size 65536))
            (when (and (= status 0) (> size (- base-len offset))) (setq status 5))
            (when (and (= status 0) (> size (- output-len written))) (setq status 6))
            (setq i 0)
            (while (and (= status 0) (<= (+ i 8) size))
              (ptr-write-u64 output (+ written i) (ptr-read-u64 base (+ offset i)))
              (setq i (+ i 8)))
            (while (and (= status 0) (< i size))
              (ptr-write-u8 output (+ written i) (ptr-read-u8 base (+ offset i)))
              (setq i (+ i 1)))
            (when (= status 0) (setq written (+ written size))))
        (if (= command 0)
            (setq status 4)
          (if (> command (- delta-len p))
              (setq status 4)
            (if (> command (- output-len written))
                (setq status 6)
              (setq i 0)
              (while (<= (+ i 8) command)
                (ptr-write-u64 output (+ written i) (ptr-read-u64 delta (+ p i)))
                (setq i (+ i 8)))
              (while (< i command)
                (ptr-write-u8 output (+ written i) (ptr-read-u8 delta (+ p i)))
                (setq i (+ i 1)))
              (setq p (+ p command) written (+ written command)))))))
    (when (and (= status 0) (/= written output-len)) (setq status 3))
    status))
