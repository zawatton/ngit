;;; ngit-xdiff.el --- Byte-exact port of git's xdiff unified diff  -*- lexical-binding: t; -*-

;;; Commentary:

;; A port of git 2.47 xdiff (xprepare.c, xdiffi.c, xemit.c) restricted to
;; the settings `git diff' uses by default: Myers algorithm without
;; XDF_NEED_MINIMAL, indent heuristic on, interhunk context 0 and the
;; default function-name matcher (def_ff).  Only plain Emacs Lisp is used
;; (no cl-lib) so the file runs on the NeLisp standalone runtime.
;;
;; Entry point: (ngit-xdiff-unified OLD NEW CONTEXT) returns the hunks as a
;; unibyte string, or "" when the inputs are equal.
;;
;; Representation notes:
;; - A record is one line including its trailing "\n" (the last line may
;;   lack it), exactly as xdiff stores records.
;; - Records are classified into equality classes (`ha' = class index).
;; - `rchg' vectors have one slot of padding on each side: C index I is
;;   stored at vector index (1+ I), so rchg[-1] and rchg[nrec] read 0.
;; - Myers kvdf/kvdb arrays are vectors addressed with offset KOFF.

;;; Code:

(defconst ngit-xdiff--max-eqlimit 1024)
(defconst ngit-xdiff--simscan-window 100)
(defconst ngit-xdiff--kpdis-run 4)
(defconst ngit-xdiff--max-cost-min 256)
(defconst ngit-xdiff--heur-min-cost 256)
(defconst ngit-xdiff--snake-cnt 20)
(defconst ngit-xdiff--k-heur 4)
(defconst ngit-xdiff--line-max most-positive-fixnum)

(defconst ngit-xdiff--max-indent 200)
(defconst ngit-xdiff--max-blanks 20)
(defconst ngit-xdiff--indent-max-sliding 100)
(defconst ngit-xdiff--func-buf-size 80)

;;;; Line splitting and classification (xprepare.c)

(defun ngit-xdiff--split (s)
  "Split unibyte string S into a vector of records, newline included."
  (let ((n (length s)) (i 0) (start 0) (acc nil))
    (while (< i n)
      (when (eq (aref s i) 10)
        (setq acc (cons (substring s start (1+ i)) acc))
        (setq start (1+ i)))
      (setq i (1+ i)))
    (when (< start n)
      (setq acc (cons (substring s start) acc)))
    (vconcat (nreverse acc))))

(defun ngit-xdiff--bogosqrt (n)
  "Integer square-root approximation from xutils.c."
  (let ((i 1))
    (while (> n 0)
      (setq i (* i 2))
      (setq n (/ n 4)))
    i))

(defun ngit-xdiff--classify (recs table counts which)
  "Map each record in RECS to its class index via TABLE.
COUNTS is a vector of two vectors (len1 len2); WHICH selects the slot.
Return a vector of class indices.  The next free class index is kept
in TABLE under the key `:count'."
  (let* ((n (length recs)) (ha (make-vector n 0)) (i 0)
         (cnt (aref counts which)) idx line)
    (while (< i n)
      (setq line (aref recs i))
      (setq idx (gethash line table))
      (unless idx
        (setq idx (gethash :count table))
        (puthash :count (1+ idx) table)
        (puthash line idx table))
      (aset cnt idx (1+ (aref cnt idx)))
      (aset ha i idx)
      (setq i (1+ i)))
    ha))

(defun ngit-xdiff--clean-mmatch (dis i s e)
  "Port of xdl_clean_mmatch."
  (let ((r 1) (rdis0 0) (rpdis0 1) (rdis1 0) (rpdis1 1) (stop nil) v)
    (when (> (- i s) ngit-xdiff--simscan-window)
      (setq s (- i ngit-xdiff--simscan-window)))
    (when (> (- e i) ngit-xdiff--simscan-window)
      (setq e (+ i ngit-xdiff--simscan-window)))
    (while (and (not stop) (>= (- i r) s))
      (setq v (aref dis (- i r)))
      (cond ((eq v 0) (setq rdis0 (1+ rdis0)))
            ((eq v 2) (setq rpdis0 (1+ rpdis0)))
            (t (setq stop t)))
      (setq r (1+ r)))
    (if (= rdis0 0)
        nil
      (setq r 1 stop nil)
      (while (and (not stop) (<= (+ i r) e))
        (setq v (aref dis (+ i r)))
        (cond ((eq v 0) (setq rdis1 (1+ rdis1)))
              ((eq v 2) (setq rpdis1 (1+ rpdis1)))
              (t (setq stop t)))
        (setq r (1+ r)))
      (if (= rdis1 0)
          nil
        (setq rdis1 (+ rdis1 rdis0))
        (setq rpdis1 (+ rpdis1 rpdis0))
        (< (* rpdis1 ngit-xdiff--kpdis-run) (+ rpdis1 rdis1))))))

(defun ngit-xdiff--cleanup (ha nrec dstart dend other-cnt rchg)
  "Port of one half of xdl_cleanup_records.
HA is the full class vector, OTHER-CNT the class counts of the other file.
Mark discarded records in RCHG and return (RINDEX . RHA) vectors."
  (let ((mlim (ngit-xdiff--bogosqrt nrec))
        (dis (make-vector (+ nrec 1) 0))
        (i dstart) (nreff 0) nm d keep
        (rindex (make-vector (max 0 (1+ (- dend dstart))) 0))
        (rha (make-vector (max 0 (1+ (- dend dstart))) 0)))
    (when (> mlim ngit-xdiff--max-eqlimit)
      (setq mlim ngit-xdiff--max-eqlimit))
    (while (<= i dend)
      (setq nm (aref other-cnt (aref ha i)))
      (aset dis i (cond ((= nm 0) 0) ((>= nm mlim) 2) (t 1)))
      (setq i (1+ i)))
    (setq i dstart)
    (while (<= i dend)
      (setq d (aref dis i))
      (setq keep (or (eq d 1)
                     (and (eq d 2)
                          (not (ngit-xdiff--clean-mmatch dis i dstart dend)))))
      (if keep
          (progn
            (aset rindex nreff i)
            (aset rha nreff (aref ha i))
            (setq nreff (1+ nreff)))
        (aset rchg (1+ i) 1))
      (setq i (1+ i)))
    (cons (if (= nreff (length rindex)) rindex (ngit-xdiff--subvec rindex nreff))
          (if (= nreff (length rha)) rha (ngit-xdiff--subvec rha nreff)))))

(defun ngit-xdiff--subvec (v n)
  "Return a fresh vector holding the first N elements of V."
  (let ((r (make-vector n 0)) (i 0))
    (while (< i n)
      (aset r i (aref v i))
      (setq i (1+ i)))
    r))

;;;; Myers diff (xdiffi.c)

(defvar ngit-xdiff--kvdf nil)
(defvar ngit-xdiff--kvdb nil)
(defvar ngit-xdiff--koff 0)
(defvar ngit-xdiff--mxcost 0)

(defun ngit-xdiff--split-point (ha1 off1 lim1 ha2 off2 lim2 need-min)
  "Port of xdl_split.  Return [I1 I2 MIN-LO MIN-HI]."
  (let* ((kvdf ngit-xdiff--kvdf) (kvdb ngit-xdiff--kvdb) (ko ngit-xdiff--koff)
         (dmin (- off1 lim2)) (dmax (- lim1 off2))
         (fmid (- off1 off2)) (bmid (- lim1 lim2))
         (odd (= 1 (logand (- fmid bmid) 1)))
         (fmin fmid) (fmax fmid) (bmin bmid) (bmax bmid)
         (snake ngit-xdiff--snake-cnt)
         (ec 1) got-snake d i1 i2 prev1 best dd v k found)
    (aset kvdf (+ fmid ko) off1)
    (aset kvdb (+ bmid ko) lim1)
    (catch 'done
      (while t
        (setq got-snake nil)
        ;; Forward pass.
        (if (> fmin dmin)
            (progn (setq fmin (1- fmin)) (aset kvdf (+ fmin -1 ko) -1))
          (setq fmin (1+ fmin)))
        (if (< fmax dmax)
            (progn (setq fmax (1+ fmax)) (aset kvdf (+ fmax 1 ko) -1))
          (setq fmax (1- fmax)))
        (setq d fmax)
        (while (>= d fmin)
          (if (>= (aref kvdf (+ d -1 ko)) (aref kvdf (+ d 1 ko)))
              (setq i1 (1+ (aref kvdf (+ d -1 ko))))
            (setq i1 (aref kvdf (+ d 1 ko))))
          (setq prev1 i1)
          (setq i2 (- i1 d))
          (while (and (< i1 lim1) (< i2 lim2)
                      (eq (aref ha1 i1) (aref ha2 i2)))
            (setq i1 (1+ i1) i2 (1+ i2)))
          (when (> (- i1 prev1) snake)
            (setq got-snake t))
          (aset kvdf (+ d ko) i1)
          (when (and odd (<= bmin d) (<= d bmax) (<= (aref kvdb (+ d ko)) i1))
            (throw 'done (vector i1 i2 t t)))
          (setq d (- d 2)))
        ;; Backward pass.
        (if (> bmin dmin)
            (progn (setq bmin (1- bmin))
                   (aset kvdb (+ bmin -1 ko) ngit-xdiff--line-max))
          (setq bmin (1+ bmin)))
        (if (< bmax dmax)
            (progn (setq bmax (1+ bmax))
                   (aset kvdb (+ bmax 1 ko) ngit-xdiff--line-max))
          (setq bmax (1- bmax)))
        (setq d bmax)
        (while (>= d bmin)
          (if (< (aref kvdb (+ d -1 ko)) (aref kvdb (+ d 1 ko)))
              (setq i1 (aref kvdb (+ d -1 ko)))
            (setq i1 (1- (aref kvdb (+ d 1 ko)))))
          (setq prev1 i1)
          (setq i2 (- i1 d))
          (while (and (> i1 off1) (> i2 off2)
                      (eq (aref ha1 (1- i1)) (aref ha2 (1- i2))))
            (setq i1 (1- i1) i2 (1- i2)))
          (when (> (- prev1 i1) snake)
            (setq got-snake t))
          (aset kvdb (+ d ko) i1)
          (when (and (not odd) (<= fmin d) (<= d fmax) (<= i1 (aref kvdf (+ d ko))))
            (throw 'done (vector i1 i2 t t)))
          (setq d (- d 2)))
        (unless need-min
          ;; Heuristic: look for a good snake when the cost grows.
          (when (and got-snake (> ec ngit-xdiff--heur-min-cost))
            (setq best 0 found nil)
            (setq d fmax)
            (while (>= d fmin)
              (setq dd (if (> d fmid) (- d fmid) (- fmid d)))
              (setq i1 (aref kvdf (+ d ko)))
              (setq i2 (- i1 d))
              (setq v (- (+ (- i1 off1) (- i2 off2)) dd))
              (when (and (> v (* ngit-xdiff--k-heur ec)) (> v best)
                         (<= (+ off1 snake) i1) (< i1 lim1)
                         (<= (+ off2 snake) i2) (< i2 lim2))
                (setq k 1)
                (catch 'brk
                  (while (eq (aref ha1 (- i1 k)) (aref ha2 (- i2 k)))
                    (when (= k snake)
                      (setq best v found (vector i1 i2 t nil))
                      (throw 'brk nil))
                    (setq k (1+ k)))))
              (setq d (- d 2)))
            (when (> best 0)
              (throw 'done found))
            (setq best 0)
            (setq d bmax)
            (while (>= d bmin)
              (setq dd (if (> d bmid) (- d bmid) (- bmid d)))
              (setq i1 (aref kvdb (+ d ko)))
              (setq i2 (- i1 d))
              (setq v (- (+ (- lim1 i1) (- lim2 i2)) dd))
              (when (and (> v (* ngit-xdiff--k-heur ec)) (> v best)
                         (< off1 i1) (<= i1 (- lim1 snake))
                         (< off2 i2) (<= i2 (- lim2 snake)))
                (setq k 0)
                (catch 'brk
                  (while (eq (aref ha1 (+ i1 k)) (aref ha2 (+ i2 k)))
                    (when (= k (1- snake))
                      (setq best v found (vector i1 i2 nil t))
                      (throw 'brk nil))
                    (setq k (1+ k)))))
              (setq d (- d 2)))
            (when (> best 0)
              (throw 'done found)))
          ;; Cost limit reached: take the furthest reaching path.
          (when (>= ec ngit-xdiff--mxcost)
            (let ((fbest -1) (fbest1 -1)
                  (bbest ngit-xdiff--line-max) (bbest1 ngit-xdiff--line-max))
              (setq d fmax)
              (while (>= d fmin)
                (setq i1 (min (aref kvdf (+ d ko)) lim1))
                (setq i2 (- i1 d))
                (when (< lim2 i2)
                  (setq i1 (+ lim2 d) i2 lim2))
                (when (< fbest (+ i1 i2))
                  (setq fbest (+ i1 i2) fbest1 i1))
                (setq d (- d 2)))
              (setq d bmax)
              (while (>= d bmin)
                (setq i1 (max off1 (aref kvdb (+ d ko))))
                (setq i2 (- i1 d))
                (when (< i2 off2)
                  (setq i1 (+ off2 d) i2 off2))
                (when (< (+ i1 i2) bbest)
                  (setq bbest (+ i1 i2) bbest1 i1))
                (setq d (- d 2)))
              (if (< (- (+ lim1 lim2) bbest) (- fbest (+ off1 off2)))
                  (throw 'done (vector fbest1 (- fbest fbest1) t nil))
                (throw 'done (vector bbest1 (- bbest bbest1) nil t))))))
        (setq ec (1+ ec))))))

(defun ngit-xdiff--recs-cmp (ha1 rindex1 rchg1 off1 lim1
                                 ha2 rindex2 rchg2 off2 lim2 need-min)
  "Port of xdl_recs_cmp."
  (while (and (< off1 lim1) (< off2 lim2)
              (eq (aref ha1 off1) (aref ha2 off2)))
    (setq off1 (1+ off1) off2 (1+ off2)))
  (while (and (< off1 lim1) (< off2 lim2)
              (eq (aref ha1 (1- lim1)) (aref ha2 (1- lim2))))
    (setq lim1 (1- lim1) lim2 (1- lim2)))
  (cond
   ((= off1 lim1)
    (while (< off2 lim2)
      (aset rchg2 (1+ (aref rindex2 off2)) 1)
      (setq off2 (1+ off2))))
   ((= off2 lim2)
    (while (< off1 lim1)
      (aset rchg1 (1+ (aref rindex1 off1)) 1)
      (setq off1 (1+ off1))))
   (t
    (let* ((spl (ngit-xdiff--split-point ha1 off1 lim1 ha2 off2 lim2 need-min))
           (s1 (aref spl 0)) (s2 (aref spl 1)))
      (ngit-xdiff--recs-cmp ha1 rindex1 rchg1 off1 s1
                            ha2 rindex2 rchg2 off2 s2 (aref spl 2))
      (ngit-xdiff--recs-cmp ha1 rindex1 rchg1 s1 lim1
                            ha2 rindex2 rchg2 s2 lim2 (aref spl 3))))))

;;;; Change compaction and the indent heuristic (xdiffi.c)

;; A file object is a vector [NREC HA RCHG RECS INDENT-CACHE].

(defun ngit-xdiff--get-indent (xdf i)
  "Port of get_indent for record I of XDF, cached."
  (let* ((cache (aref xdf 4)) (c (aref cache i)))
    (if (not (eq c -2))
        c
      (let* ((rec (aref (aref xdf 3) i)) (n (length rec)) (j 0)
             (ret 0) (res nil) ch)
        (while (and (not res) (< j n))
          (setq ch (aref rec j))
          (cond ((eq ch 32) (setq ret (1+ ret)))
                ((eq ch 9) (setq ret (+ ret (- 8 (% ret 8)))))
                ((or (eq ch 10) (eq ch 13)) nil)
                (t (setq res ret)))
          (when (and (not res) (>= ret ngit-xdiff--max-indent))
            (setq res ngit-xdiff--max-indent))
          (setq j (1+ j)))
        (unless res (setq res -1))
        (aset cache i res)
        res))))

(defun ngit-xdiff--score-split (xdf split score)
  "Measure SPLIT in XDF and add it to SCORE, a cons (EFF-INDENT . PENALTY)."
  (let* ((nrec (aref xdf 0))
         (eof (>= split nrec))
         (indent (if eof -1 (ngit-xdiff--get-indent xdf split)))
         (pre-blank 0) (pre-indent -1) (post-blank 0) (post-indent -1)
         (i (1- split)) (stop nil)
         (penalty (cdr score)) post-blank* total-blank ind any-blanks)
    (while (and (not stop) (>= i 0))
      (setq pre-indent (ngit-xdiff--get-indent xdf i))
      (if (/= pre-indent -1)
          (setq stop t)
        (setq pre-blank (1+ pre-blank))
        (when (= pre-blank ngit-xdiff--max-blanks)
          (setq pre-indent 0 stop t)))
      (setq i (1- i)))
    (setq i (1+ split) stop nil)
    (while (and (not stop) (< i nrec))
      (setq post-indent (ngit-xdiff--get-indent xdf i))
      (if (/= post-indent -1)
          (setq stop t)
        (setq post-blank (1+ post-blank))
        (when (= post-blank ngit-xdiff--max-blanks)
          (setq post-indent 0 stop t)))
      (setq i (1+ i)))
    ;; score_add_split
    (when (and (= pre-indent -1) (= pre-blank 0))
      (setq penalty (+ penalty 1)))
    (when eof
      (setq penalty (+ penalty 21)))
    (setq post-blank* (if (= indent -1) (1+ post-blank) 0))
    (setq total-blank (+ pre-blank post-blank*))
    (setq penalty (+ penalty (* -30 total-blank) (* 6 post-blank*)))
    (setq ind (if (/= indent -1) indent post-indent))
    (setq any-blanks (/= total-blank 0))
    (setcar score (+ (car score) ind))
    (cond ((= ind -1))
          ((= pre-indent -1))
          ((> ind pre-indent)
           (setq penalty (+ penalty (if any-blanks 10 -4))))
          ((= ind pre-indent))
          ((and (/= post-indent -1) (> post-indent ind))
           (setq penalty (+ penalty (if any-blanks 17 24))))
          (t
           (setq penalty (+ penalty (if any-blanks 17 23)))))
    (setcdr score penalty)
    score))

(defun ngit-xdiff--score-cmp (s1 s2)
  (let ((a (car s1)) (b (car s2)))
    (+ (* 60 (cond ((> a b) 1) ((< a b) -1) (t 0)))
       (- (cdr s1) (cdr s2)))))

;; Groups are vectors [START END].

(defun ngit-xdiff--rchg-at (rchg i)
  (aref rchg (1+ i)))

(defun ngit-xdiff--group-init (xdf g)
  (let ((rchg (aref xdf 2)) (e 0))
    (while (/= 0 (aref rchg (1+ e)))
      (setq e (1+ e)))
    (aset g 0 0)
    (aset g 1 e)))

(defun ngit-xdiff--group-next (xdf g)
  "Advance G; return non-nil on failure (end of file)."
  (if (= (aref g 1) (aref xdf 0))
      t
    (let ((rchg (aref xdf 2)) (e (1+ (aref g 1))))
      (aset g 0 e)
      (while (/= 0 (aref rchg (1+ e)))
        (setq e (1+ e)))
      (aset g 1 e)
      nil)))

(defun ngit-xdiff--group-prev (xdf g)
  "Move G back; return non-nil on failure (start of file)."
  (if (= (aref g 0) 0)
      t
    (let ((rchg (aref xdf 2)) (s (1- (aref g 0))))
      (aset g 1 s)
      (while (/= 0 (aref rchg s))
        (setq s (1- s)))
      (aset g 0 s)
      nil)))

(defun ngit-xdiff--slide-down (xdf g)
  (let ((ha (aref xdf 1)) (rchg (aref xdf 2)) (s (aref g 0)) (e (aref g 1)))
    (if (and (< e (aref xdf 0)) (eq (aref ha s) (aref ha e)))
        (progn
          (aset rchg (1+ s) 0)
          (aset rchg (1+ e) 1)
          (setq s (1+ s) e (1+ e))
          (while (/= 0 (aref rchg (1+ e)))
            (setq e (1+ e)))
          (aset g 0 s)
          (aset g 1 e)
          nil)
      t)))

(defun ngit-xdiff--slide-up (xdf g)
  (let ((ha (aref xdf 1)) (rchg (aref xdf 2)) (s (aref g 0)) (e (aref g 1)))
    (if (and (> s 0) (eq (aref ha (1- s)) (aref ha (1- e))))
        (progn
          (setq s (1- s) e (1- e))
          (aset rchg (1+ s) 1)
          (aset rchg (1+ e) 0)
          (while (/= 0 (aref rchg s))
            (setq s (1- s)))
          (aset g 0 s)
          (aset g 1 e)
          nil)
      t)))

(defun ngit-xdiff--change-compact (xdf xdfo)
  "Port of xdl_change_compact with XDF_INDENT_HEURISTIC."
  (let ((g (vector 0 0)) (go (vector 0 0))
        earliest-end end-matching-other groupsize done)
    (ngit-xdiff--group-init xdf g)
    (ngit-xdiff--group-init xdfo go)
    (while (not done)
      (unless (= (aref g 1) (aref g 0))
        (setq groupsize -1)
        (while (/= groupsize (- (aref g 1) (aref g 0)))
          (setq groupsize (- (aref g 1) (aref g 0)))
          (setq end-matching-other -1)
          (while (not (ngit-xdiff--slide-up xdf g))
            (ngit-xdiff--group-prev xdfo go))
          (setq earliest-end (aref g 1))
          (when (> (aref go 1) (aref go 0))
            (setq end-matching-other (aref g 1)))
          (while (not (ngit-xdiff--slide-down xdf g))
            (ngit-xdiff--group-next xdfo go)
            (when (> (aref go 1) (aref go 0))
              (setq end-matching-other (aref g 1)))))
        (cond
         ((= (aref g 1) earliest-end))
         ((/= end-matching-other -1)
          (while (= (aref go 1) (aref go 0))
            (ngit-xdiff--slide-up xdf g)
            (ngit-xdiff--group-prev xdfo go)))
         (t
          (let ((shift earliest-end) (best-shift -1) (best-score nil)
                (gend (aref g 1)) score)
            (when (> (- gend groupsize 1) shift)
              (setq shift (- gend groupsize 1)))
            (when (> (- gend ngit-xdiff--indent-max-sliding) shift)
              (setq shift (- gend ngit-xdiff--indent-max-sliding)))
            (while (<= shift gend)
              (setq score (cons 0 0))
              (ngit-xdiff--score-split xdf shift score)
              (ngit-xdiff--score-split xdf (- shift groupsize) score)
              (when (or (= best-shift -1)
                        (<= (ngit-xdiff--score-cmp score best-score) 0))
                (setq best-score score best-shift shift))
              (setq shift (1+ shift)))
            (while (> (aref g 1) best-shift)
              (ngit-xdiff--slide-up xdf g)
              (ngit-xdiff--group-prev xdfo go))))))
      (if (ngit-xdiff--group-next xdf g)
          (setq done t)
        (ngit-xdiff--group-next xdfo go)))))

(defun ngit-xdiff--build-script (rchg1 n1 rchg2 n2)
  "Port of xdl_build_script.  Return ascending list of [I1 I2 CHG1 CHG2]."
  (let ((i1 n1) (i2 n2) (acc nil) l1 l2)
    (while (or (>= i1 0) (>= i2 0))
      (when (or (and (>= i1 0) (/= 0 (aref rchg1 i1)))
                (and (>= i2 0) (/= 0 (aref rchg2 i2))))
        (setq l1 i1 l2 i2)
        (while (and (>= i1 0) (/= 0 (aref rchg1 i1)))
          (setq i1 (1- i1)))
        (while (and (>= i2 0) (/= 0 (aref rchg2 i2)))
          (setq i2 (1- i2)))
        (setq acc (cons (vector i1 i2 (- l1 i1) (- l2 i2)) acc)))
      (setq i1 (1- i1) i2 (1- i2)))
    acc))

;;;; Emission (xemit.c, xutils.c)

(defun ngit-xdiff--def-ff (rec)
  "Default function-name matcher; return header text or nil."
  (let ((len (length rec)) c)
    (when (> len 0)
      (setq c (aref rec 0))
      (when (or (and (>= c ?a) (<= c ?z)) (and (>= c ?A) (<= c ?Z))
                (eq c ?_) (eq c ?$))
        (when (> len ngit-xdiff--func-buf-size)
          (setq len ngit-xdiff--func-buf-size))
        (while (and (> len 0)
                    (memq (aref rec (1- len)) '(32 9 10 13)))
          (setq len (1- len)))
        (substring rec 0 len)))))

(defun ngit-xdiff--hunk-range (s c)
  (if (= c 1)
      (number-to-string s)
    (concat (number-to-string (if (= c 0) (1- s) s)) ","
            (number-to-string c))))

(defun ngit-xdiff--sane-truncate-line (line)
  "Truncate LINE at the first invalid UTF-8 byte, as git does."
  (let ((len (length line)) (i 0) (valid t) c c1 step j)
    (while (and valid (< i len))
      (setq c (aref line i))
      (setq step (cond ((< c #x80) 1)
                       ((= (logand c #xe0) #xc0) 2)
                       ((= (logand c #xf0) #xe0) 3)
                       ((= (logand c #xf8) #xf0) 4)
                       (t 0)))
      (setq valid (and (> step 0) (<= (+ i step) len)) j 1)
      (while (and valid (< j step))
        (setq valid (= (logand (aref line (+ i j)) #xc0) #x80))
        (setq j (1+ j)))
      (when (and valid (> step 1))
        (setq c1 (aref line (1+ i)))
        ;; Match pick_one_utf8_char, including its noncharacter check.
        (setq valid
              (cond
               ((= step 2) (/= (logand c #xfe) #xc0))
               ((= step 3)
                (not (or (and (= c #xe0) (= (logand c1 #xe0) #x80))
                         (and (= c #xed) (= (logand c1 #xe0) #xa0))
                         (and (= c #xef) (= c1 #xbf)
                              (= (logand (aref line (+ i 2)) #xfe) #xbe)))))
               (t
                (not (or (and (= c #xf0) (= (logand c1 #xf0) #x80))
                         (and (= c #xf4) (> c1 #x8f))
                         (> c #xf4)))))))
      (when valid (setq i (+ i step))))
    (if valid
        line
      (concat (substring line 0 i)
              (if (and (> i 0) (= (aref line (1- i)) 10)) "" "\n")))))

(defun ngit-xdiff--emit (recs1 recs2 script ctx)
  "Port of xdl_emit_diff for SCRIPT (list of change vectors)."
  (let ((n1 (length recs1)) (n2 (length recs2))
        (out nil) (funclineprev -1) (func "")
        (max-common (* 2 ctx))
        (nl-marker "\n\\ No newline at end of file\n")
        xch xche s1 s2 e1 e2 lctx tail rec)
    (setq xch script)
    (while xch
      ;; xdl_get_hunk without ignorable changes.
      (setq tail xch)
      (while (and (cdr tail)
                  (let ((a (car tail)) (b (cadr tail)))
                    (<= (- (aref b 0) (+ (aref a 0) (aref a 2))) max-common)))
        (setq tail (cdr tail)))
      (setq xche (car tail))
      (setq s1 (max (- (aref (car xch) 0) ctx) 0))
      (setq s2 (max (- (aref (car xch) 1) ctx) 0))
      (setq lctx ctx)
      (setq lctx (min lctx (- n1 (+ (aref xche 0) (aref xche 2)))))
      (setq lctx (min lctx (- n2 (+ (aref xche 1) (aref xche 3)))))
      (setq e1 (+ (aref xche 0) (aref xche 2) lctx))
      (setq e2 (+ (aref xche 1) (aref xche 3) lctx))
      ;; Function name lookup with git's caching across hunks.
      (let* ((start (1- s1)) (limit funclineprev)
             (step (if (> start limit) -1 1)) (l start) (found nil))
        (while (and (not found) (/= l limit) (<= 0 l) (< l n1))
          (setq found (ngit-xdiff--def-ff (aref recs1 l)))
          (setq l (+ l step)))
        (when found (setq func found))
        (setq funclineprev (1- s1)))
      (let ((header (concat "@@ -" (ngit-xdiff--hunk-range (1+ s1) (- e1 s1))
                            " +" (ngit-xdiff--hunk-range (1+ s2) (- e2 s2))
                            " @@"
                            (if (> (length func) 0) (concat " " func) "")
                            "\n")))
        ;; The prefix is ASCII; only non-ASCII function text needs decoding.
        (when (string-match-p "[\200-\377]" func)
          (setq header (ngit-xdiff--sane-truncate-line header)))
        (setq out (cons header out)))
      ;; Pre-context.
      (while (< s2 (aref (car xch) 1))
        (setq rec (aref recs2 s2))
        (setq out (cons rec (cons " " out)))
        (setq s2 (1+ s2)))
      (setq s1 (aref (car xch) 0) s2 (aref (car xch) 1))
      (let ((cur xch) (c nil) (stop nil) lim)
        (while (not stop)
          (setq c (car cur))
          (while (and (< s1 (aref c 0)) (< s2 (aref c 1)))
            (setq out (cons (aref recs2 s2) (cons " " out)))
            (setq s1 (1+ s1) s2 (1+ s2)))
          (setq s1 (aref c 0) lim (+ (aref c 0) (aref c 2)))
          (while (< s1 lim)
            (setq rec (aref recs1 s1))
            (setq out (cons rec (cons "-" out)))
            (unless (eq (aref rec (1- (length rec))) 10)
              (setq out (cons nl-marker out)))
            (setq s1 (1+ s1)))
          (setq s2 (aref c 1) lim (+ (aref c 1) (aref c 3)))
          (while (< s2 lim)
            (setq rec (aref recs2 s2))
            (setq out (cons rec (cons "+" out)))
            (unless (eq (aref rec (1- (length rec))) 10)
              (setq out (cons nl-marker out)))
            (setq s2 (1+ s2)))
          (if (eq cur tail)
              (setq stop t)
            (setq s1 (+ (aref c 0) (aref c 2)))
            (setq s2 (+ (aref c 1) (aref c 3)))
            (setq cur (cdr cur)))))
      ;; Post-context.
      (setq s2 (+ (aref xche 1) (aref xche 3)))
      (while (< s2 e2)
        (setq rec (aref recs2 s2))
        (setq out (cons rec (cons " " out)))
        (unless (eq (aref rec (1- (length rec))) 10)
          (setq out (cons nl-marker out)))
        (setq s2 (1+ s2)))
      (setq xch (cdr tail)))
    (apply #'concat (nreverse out))))

;;;; Entry point

(defun ngit-xdiff-unified (old new context)
  "Return git-style unified diff hunks between unibyte strings OLD and NEW.
CONTEXT is the number of context lines.  Return \"\" when equal."
  (if (string= old new)
      ""
    (let* ((recs1 (ngit-xdiff--split old))
           (recs2 (ngit-xdiff--split new))
           (n1 (length recs1)) (n2 (length recs2))
           (table (make-hash-table :test 'equal :size (+ n1 n2 1)))
           (counts (vector (make-vector (+ n1 n2 1) 0)
                           (make-vector (+ n1 n2 1) 0)))
           ha1 ha2 rchg1 rchg2 dstart dend1 dend2 r1 r2 lim i)
      (puthash :count 0 table)
      (setq ha1 (ngit-xdiff--classify recs1 table counts 0))
      (setq ha2 (ngit-xdiff--classify recs2 table counts 1))
      (setq rchg1 (make-vector (+ n1 2) 0))
      (setq rchg2 (make-vector (+ n2 2) 0))
      ;; xdl_trim_ends
      (setq i 0 lim (min n1 n2))
      (while (and (< i lim) (eq (aref ha1 i) (aref ha2 i)))
        (setq i (1+ i)))
      (setq dstart i)
      (setq lim (- lim i) i 0)
      (while (and (< i lim)
                  (eq (aref ha1 (- n1 1 i)) (aref ha2 (- n2 1 i))))
        (setq i (1+ i)))
      (setq dend1 (- n1 i 1) dend2 (- n2 i 1))
      ;; xdl_cleanup_records
      (setq r1 (ngit-xdiff--cleanup ha1 n1 dstart dend1 (aref counts 1) rchg1))
      (setq r2 (ngit-xdiff--cleanup ha2 n2 dstart dend2 (aref counts 0) rchg2))
      ;; xdl_do_diff
      (let* ((nreff1 (length (car r1))) (nreff2 (length (car r2)))
             (ndiags (+ nreff1 nreff2 3)))
        (setq ngit-xdiff--kvdf (make-vector (+ ndiags 1) 0))
        (setq ngit-xdiff--kvdb (make-vector (+ ndiags 1) 0))
        (setq ngit-xdiff--koff (1+ nreff2))
        (setq ngit-xdiff--mxcost (max (ngit-xdiff--bogosqrt ndiags)
                                      ngit-xdiff--max-cost-min))
        (ngit-xdiff--recs-cmp (cdr r1) (car r1) rchg1 0 nreff1
                              (cdr r2) (car r2) rchg2 0 nreff2 nil))
      (setq ngit-xdiff--kvdf nil ngit-xdiff--kvdb nil)
      (let ((xdf1 (vector n1 ha1 rchg1 recs1 (make-vector (max n1 1) -2)))
            (xdf2 (vector n2 ha2 rchg2 recs2 (make-vector (max n2 1) -2))))
        (ngit-xdiff--change-compact xdf1 xdf2)
        (ngit-xdiff--change-compact xdf2 xdf1))
      (let ((script (ngit-xdiff--build-script rchg1 n1 rchg2 n2)))
        (if script
            (ngit-xdiff--emit recs1 recs2 script context)
          "")))))

(provide 'ngit-xdiff)

